    {
      "etype": "mistycannon",
      "label": "Misty Cannon",
      "category": "Interactive Objects",
      "parent": "process-drawable",
      "description": "Lurker cannon. Fires sacks at Jak while a Babak with cannon (its Alt actor = this) rides it; otherwise Jak can use it (circle at the grips). Its own rotation is ignored: the yaw limits are world angles (0 = -Blender Y).",
      "art_group": [
        "mistycannon-ag.go",
        "sack-ag.go"
      ],
