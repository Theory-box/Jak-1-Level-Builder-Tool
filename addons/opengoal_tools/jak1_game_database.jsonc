              "required": false
            },
            {
              "lump_key": "next-actor",
              "slot": 0,
              "label": "Next robber in the list",
              "accepts": [
                "robber"
              ],
              "required": false
            }
          ]
        },
        {
          "panel": "activation"
        },
        {
          "panel": "visibility",
          "fields": [
            {
              "key": "og_vis_dist",
              "default": 200.0
            }
          ]
        }
      ],
      "description": "Robbers of one task must be linked both ways (A next = B, B prev = A): the cell comes from the last one caught, and a lone robber never gives one. Never link a robber to itself (the game hangs). The cell flies at least 26 m high (vanilla clamp)."
    },
