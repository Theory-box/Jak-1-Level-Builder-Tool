                "any"
              ],
              "required": false,
              "allow-multiple": true,
              "show-in": "battlecontroller"
            },
            {
              "lump_key": "alt-actor",
              "slot": 0,
              "label": "Triggered when the ambush is completed (open doors, raise steps ...)",
              "accepts": [
                "any"
              ],
              "required": false,
              "allow-multiple": true,
              "show-in": "battlecontroller"
            }
          ]
        },
