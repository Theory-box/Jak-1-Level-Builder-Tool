    {
      "etype": "blue-eco-charger",
      "label": "Blue Eco Charger",
      "category": "Interactive Objects",
      "parent": "process-drawable",
      "code": "sun-exit-chamber.o",
      "art_group": [
        "blue-eco-charger-ag.go",
        "blue-eco-charger-orb-ag.go"
      ],
      "tpage_group": "Sunken",
      "glb": "levels/sunkenb/blue-eco-charger-lod0.glb",
      "shape": "CUBE",
      "description": "Opens (orb spins) when Jak comes within 4 m charged with blue eco; closes 20 s later. Starts stuck open once the vanilla Sunken charger puzzle is solved."
    },
    {
      "etype": "citb-generator",
      "label": "Citadel Generator",
      "category": "Interactive Objects",
      "parent": "process-drawable",
      "code": [
        "battlecontroller.o",
        "citadel-part.o",
        "citadel-obs.o"
      ],
      "art_group": "citb-generator-ag.go",
      "tpage_group": "Citadel",
      "glb": "levels/citadel/citb-generator-lod0.glb",
      "shape": "CUBE",
      "description": "Hit it to break it: opens its open actors, gives its task's cell, then triggers its linked actors.",
      "panels": [
        {
          "panel": "game-task",
          "description": "Cell given when broken. none: no cell."
        },
        {
          "panel": "movie-pos"
        },
        {
          "panel": "actor-link",
          "slots": [
            {
              "lump_key": "open-actor",
              "slot": 0,
              "label": "Sent 'open when broken",
              "accepts": [
                "any"
              ],
              "required": false,
              "allow-multiple": true
            },
            {
              "lump_key": "alt-actor",
              "slot": 0,
              "label": "Sent 'trigger after breaking (after its cell is collected)",
              "accepts": [
                "any"
              ],
              "required": false,
              "allow-multiple": true
            },
            {
              "lump_key": "trigger-actor",
              "slot": 0,
              "label": "Sent 'trigger 0.5 s after that",
              "accepts": [
                "any"
              ],
              "required": false,
              "allow-multiple": true
            },
            {
              "lump_key": "state-actor",
              "slot": 0,
              "label": "Starts broken if this actor is complete (default: itself)",
              "accepts": [
                "any"
              ],
              "required": false
            }
          ]
        }
      ]
    },
    {
      "etype": "test-actor",
      "label": "Test Actor",
      "category": "Debug",
      "parent": "process-drawable",
      "art_group": "test-actor-ag.go",
      "shape": "PLAIN_AXES"
    }
  ],

