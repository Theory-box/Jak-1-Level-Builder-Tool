      "category": "NPCs",
      "parent": "process-taskable",
      "code": [
        "swamp-rat.o",
        "billy.o"
      ],
      "art_group": [
        "billy-ag.go",
        "billy-sidekick-ag.go",
        "farthy-snack-ag.go",
        "swamp-rat-ag.go"
      ],
      "tpage_group": "Swamp",
      "glb": "levels/swamp/billy-lod0.glb",
      "shape": "CUBE",
      "description": "Billy and his pet Farthy (a clone-anim manipy). Task swamp-billy is hard-coded. Talk: billy-introduction cutscene (puts snack props along path 0, offset X -10 m / Z +5 m), then later talks ask to play; accepting moves Jak to the linked Jak-spot actor and starts the rat-shooting game: snacks along path 0, rats spawn at random points of path 1 and walk to random points of path 2 (rats use Billy's nav-mesh). Win: resolution cutscene gives the swamp-billy cell (at movie-pos). Lose: replay prompt. Vanilla reads all three paths from the one 'path' lump at keyframes 0/1/2, which a .jsonc lump can't hold (one entry per name): needs a level subtype reading path / pathb / pathc. Without paths 1/2 the rats spawn at the world origin and the game never ends.",
      "panels": [
        {
          "panel": "movie-pos",
          "description": "Where the swamp-billy cell plays its pickup animation after the win (cone = facing). Not set: at Jak."
        },
        {
          "panel": "nav-mesh",
          "show-panel": true
        },
        {
          "panel": "path",
          "required": [
            "path",
            "pathb",
            "pathc"
          ],
          "paths": [
            "path",
            "pathb",
            "pathc"
          ],
          "linear-only": true,
          "description": "path: snack spots (one Farthy snack per point). pathb: rat spawn points. pathc: rat waypoints (random points they wander to). Needs the billy subtype (vanilla keys all three as 'path' keyframes 0/1/2)."
        },
        {
          "panel": "actor-link",
          "slots": [
            {
              "lump_key": "alt-actor",
              "slot": 0,
              "label": "Jak's spot during the game (required)",
              "accepts": [
                "any"
              ],
              "required": true
            }
          ]
        }
      ]
    },
    {
