              "default": -10.0,
              "lump": {
                "key": "tiltmin",
                "type": "degrees"
              },
              "write_if": "if_not_default"
            },
            {
              "key": "og_mc_tiltmax",
              "label": "Tilt max (deg)",
              "type": "float",
              "default": 70.0,
              "lump": {
                "key": "tiltmax",
                "type": "degrees"
              },
