    {"id": "sun-iris-door", "label": "Sun Iris Door", "description": "Iris door settings.", "fields": []},
    {"id": "task-gated", "label": "Task Gated", "description": "Task picker for task-gated actors (oracle).", "fields": []},
    {"id": "plat-grid", "label": "Platforms", "description": "A grid of platforms spawned by one actor (citb-drop-plat): 'count [x z] and 'plat-type per slot (0 none, 1-5 colours; random without it), 4 m apart around the actor. Preview: one model per slot.", "fields": []},
    {"id": "caveelevator", "label": "Cave Elevator", "description": "Cave elevator settings.", "fields": []}
