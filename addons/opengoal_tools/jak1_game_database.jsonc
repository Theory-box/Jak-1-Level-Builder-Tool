  ],

  // ── HardcodedLumpKeys_notes ─────────────────────────────────────
  "HardcodedLumpKeys_notes": "Keys the exporter always sets automatically. Manual lump rows targeting these emit a warning but aren't blocked — manual value takes priority.",

  // ── AggroEvents ─────────────────────────────────────────────────
  "AggroEvents": [
    {
      "id": "cue-chase",
      "label": "Aggro (chase player)",
      "description": "Wake enemy and start chasing player"
    },
    {
      "id": "cue-patrol",
      "label": "Patrol",
      "description": "Return enemy to patrol state"
    },
    {
      "id": "go-wait-for-cue",
      "label": "Wait for cue (freeze)",
      "description": "Freeze enemy until next cue event"
    }
  ],

  // ── PanelTypes ──────────────────────────────────────────────────
  // UI panels an actor (or a Parents entry) can list in its "panels":
  //   {"panel": "<id>", "show-panel": true, "fields": [{"key": ..., <only what differs>}]}
  // Panels come from the parent chain and then the actor — never from the
  // category. "fields" here are each panel's standard fields; an actor's
  // entry overrides them by key ("default", "show-field": false, ...).
  // "custom-fields" takes fully written-out fields (the old "fields" key).
  // "export": false (panel or field) hides it and stops it being exported.
  // Other keys on a panel entry are panel options (path: required, linear-only, paths, min-points).
  "PanelTypes": [
    {
      "id": "path",
      "label": "Path",
      "description": "Waypoints/curves exported as 'path' (+ path-k). Options: \"required\": true or [lump names] (errors without them), \"linear-only\": true (path-control, no path-k), \"paths\": [lump names Add Path offers], \"multi-path\": true, \"min-points\": N. Brings the path-actor link slot (path-h.gc reads every path lump from that actor instead).",
      "fields": [],
      "options": {
        "slots": [
          {"lump_key": "path-actor", "slot": 0, "label": "Use the path of (instead of this actor's own; offset it with Sync)", "accepts": ["any"], "required": false}
        ]
      }
    },
    {
      "id": "sync",
      "label": "Sync",
      "description": "Path timing: how long one trip along the path takes (period), its offset (phase) and ease out / in. Wrap phase is in the fact-options panel. Option \"distribute\": true offers Distribute along the path (N copies, phase + i/N; on plat and its children). Actors that use sync for something else set their own \"description\". \"export\": false on a field leaves it out (ease fields -> 2-value sync).",
      "fields": [
        {
          "key": "og_sync_period",
          "label": "Period (s)",
          "type": "float",
          "default": 4.0,
          "min": 0.0,
          "lump": {
            "key": "sync",
            "type": "float",
            "slot": 0
          },
          "write_if": "always"
        },
        {
          "key": "og_sync_phase",
          "label": "Phase (0-1)",
          "type": "float",
          "default": 0.0,
          "lump": {
            "key": "sync",
            "type": "float",
            "slot": 1
          },
          "write_if": "always"
        },
        {
          "key": "og_sync_ease_out",
          "label": "Ease out",
          "type": "float",
          "default": 0.15,
          "min": 0.001,
          "max": 1.0,
          "note": "Minimum 0.001: at 0 the game divides by zero and the platform stops moving.",
          "lump": {
            "key": "sync",
            "type": "float",
            "slot": 2
          },
          "write_if": "always"
        },
        {
          "key": "og_sync_ease_in",
          "label": "Ease in",
          "type": "float",
          "default": 0.15,
          "min": 0.001,
          "max": 1.0,
          "lump": {
            "key": "sync",
            "type": "float",
            "slot": 3
          },
          "write_if": "always"
        }
      ]
    },
    {"id": "actor-link", "label": "Actor Links", "description": "Links to other actors (alt-actor, next-actor ...). Option \"slots\": [{lump_key, slot, label, accepts, required}].", "fields": []},
    {
      "id": "nav-mesh",
      "label": "Nav-mesh",
      "description": "Nav-mesh link. On the nav-enemy parent; other actors can list it too. Option \"fallback-sphere\": true exports nav-mesh-sphere when no navmesh is linked. Option \"can-jump\": true marks nav-enemies with a jump animation (battlecontroller lurkers, nav-mesh jumps). Fields (drawn under the link): nearest-y-threshold (nav-control, navigate-h.gc) and nav-max-users (read from the actor that owns the nav-mesh).",
      "fields": [
        {
          "key": "og_nav_y_threshold",
          "label": "Nav-mesh snap height (m)",
          "type": "float",
          "default": -1.0,
          "note": "How far above / below the nav-mesh the actor can be and still find its place on it. -1 = the actor's own default (10 m for most enemies). sharkey, muse, mother-spider, cave-trap and yakow set their own after spawning.",
          "lump": {
            "key": "nearest-y-threshold",
            "type": "meters"
          },
          "write_if": "if_nonneg"
        },
        {
          "key": "og_nav_max_users",
          "label": "Max nav-mesh users",
          "type": "int",
          "default": 32,
          "min": 1,
          "note": "How many actors can use this actor's nav-mesh at once (actors linking it with nav-mesh-actor, spawned enemies). Engine default 32.",
          "lump": {
            "key": "nav-max-users",
            "type": "int32"
          },
          "write_if": "if_not_default"
        }
      ]
    },
    {"id": "aggro-trigger", "label": "Trigger Behaviour", "description": "Aggro trigger volumes (cue-chase / cue-patrol / wait-for-cue). On the nav-enemy parent.", "fields": []},
    {"id": "volume", "label": "Volume", "description": "vol lump from a linked VOL_ mesh.", "fields": []},
    {
      "id": "water",
      "label": "Water Volume",
      "description": "Water attributes; the volume comes from a linked VOL_ mesh. The liquid sets the water flags (water-h.gc) and the attack event.",
      "fields": [
        {
          "key": "og_water_surface",
          "label": "Water surface Y (m)",
          "type": "float",
          "default": 0.0,
          "note": "World Y of the water surface. Wade/swim are depths below this.",
          "lump": {
            "key": "water-height",
            "type": "water-height",
            "components": [
              "og_water_surface",
              "og_water_wade",
              "og_water_swim"
            ],
            "liquid_key": "og_water_liquid",
            "ripple_key": "og_water_ripple",
            "liquids": {
              "water": {
                "flags": [
                  "wt02",
                  "wt03"
                ]
              },
              "water-wade-only": {
                "flags": [
                  "wt02"
                ]
              },
              "water-swim-only": {
                "flags": [
                  "wt03"
                ]
              },
              "mud": {
                "flags": [
                  "wt02",
                  "wt18"
                ]
              },
              "tar": {
                "flags": [
                  "wt02",
                  "wt17"
                ]
              },
              "lava": {
                "flags": [
                  "wt03",
                  "wt19"
                ],
                "attack": "lava"
              },
              "lava-heat": {
                "flags": [
                  "wt03",
                  "wt19"
                ],
                "attack": "heat"
              },
              "dark-eco": {
                "flags": [
                  "wt03",
                  "wt19"
                ],
                "attack": "dark-eco-pool"
              },
              "electric": {
                "flags": [
                  "wt02",
                  "wt03",
                  "wt19"
                ],
                "attack": "drown"
              },
              "electric-toggle": {
                "flags": [
                  "wt02",
                  "wt03"
                ]
              }
            }
          }
        },
        {
          "key": "og_water_wade",
          "label": "Wade depth (m)",
          "type": "float",
          "default": 0.5,
          "min": 0.0
        },
        {
          "key": "og_water_swim",
          "label": "Swim depth (m)",
          "type": "float",
          "default": 1.0,
          "min": 0.0
        },
        {
          "key": "og_water_liquid",
          "label": "Liquid",
          "type": "enum",
          "default": "water",
          "note": "Mud, tar and shallow water only let Jak wade: put ground under the surface within the wade depth or he sinks through (vanilla mud is about 0.5 m deep). Tar only hurts below world Y -0.1 m (vanilla check). Lava / dark eco kill on contact.",
          "choices": [
            {
              "value": "water",
              "label": "Water (wade, swim, drown)"
            },
            {
              "value": "water-wade-only",
              "label": "Shallow water (wade only)"
            },
            {
              "value": "water-swim-only",
              "label": "Deep water (swim only)"
            },
            {
              "value": "mud",
              "label": "Mud (slows)"
            },
            {
              "value": "tar",
              "label": "Tar (sinks + hurts; only near world Y 0)"
            },
            {
              "value": "lava",
              "label": "Lava (instant death)"
            },
            {
              "value": "dark-eco",
              "label": "Dark eco (instant death)"
            },
            {
              "value": "electric",
              "label": "Electric water (hurts)"
            }
          ]
        },
        {
          "key": "og_water_ripple",
          "label": "Surface follows its look",
          "type": "bool",
          "default": false,
          "show-field": false
        }
      ]
    },
    {
      "id": "activation",
      "label": "Activation",
      "description": "fact-info-enemy lumps (engine/game/fact-h.gc): idle distance, camera when attacked, notice height. Drawn in the Nav Behaviour panel. notice-top is only read by nav-enemy and puffer, so it is hidden unless a parent/actor turns it on.",
      "fields": [
        {
          "key": "og_idle_distance",
          "label": "Idle distance (m)",
          "type": "float",
          "default": 80.0,
          "note": "Player must be within this range for the enemy to leave idle. Engine default 80.",
          "lump": {
            "key": "idle-distance",
            "type": "meters"
          }
        },
        {
          "key": "og_notice_top",
          "label": "Notice height (m)",
          "type": "float",
          "default": 1000.0,
          "note": "Jak is only noticed / chased while he is lower than the enemy's height + this. Engine default 1000 (no limit).",
          "lump": {
            "key": "notice-top",
            "type": "meters"
          },
          "write_if": "if_not_default",
          "show-field": false,
          "export": false
        },
        {
          "key": "og_notice_bottom",
          "label": "Notice depth (m)",
          "type": "float",
          "default": 1000.0,
          "note": "Below-the-enemy counterpart of Notice height. The engine reads it but no vanilla code uses it yet (only custom code would). Engine default 1000.",
          "lump": {
            "key": "notice-bottom",
            "type": "meters"
          },
          "write_if": "if_not_default",
          "show-field": false,
          "export": false
        },
        {
          "key": "og_cam_notice_dist",
          "label": "Attack camera range (m)",
          "type": "float",
          "default": -1.0,
          "note": "When this enemy attacks Jak within this range, Jak looks at it and the camera uses the height / distance below. -1 = off (engine default).",
          "lump": {
            "key": "cam-notice-dist",
            "type": "meters"
          },
          "write_if": "if_not_default"
        },
        {
          "key": "og_cam_vert",
          "label": "Attack camera height (m)",
          "type": "float",
          "default": 0.0,
          "note": "While attacked (within the range above) the camera rises to at least this height. 0 = no change.",
          "lump": {
            "key": "cam-vert",
            "type": "meters"
          },
          "write_if": "if_nonzero"
        },
        {
          "key": "og_cam_horz",
          "label": "Attack camera distance (m)",
          "type": "float",
          "default": 0.0,
          "note": "While attacked (within the range above) the camera pulls back to at least this distance. 0 = no change.",
          "lump": {
            "key": "cam-horz",
            "type": "meters"
          },
          "write_if": "if_nonzero"
        }
      ]
    },
    {
      "id": "visibility",
      "label": "Visibility",
      "description": "vis-dist: draw distance of the last LOD (process-drawable setup-lods!, any actor with a skeleton whose last LOD has no distance). On the process-drawable parent; enemies keep their old 200 m default.",
      "fields": [
        {
          "key": "og_vis_dist",
          "label": "Vis distance (m)",
          "type": "float",
          "default": -1.0,
          "note": "The actor stops drawing beyond this distance. -1 = engine default (no limit).",
          "lump": {
            "key": "vis-dist",
            "type": "meters"
          },
          "write_if": "if_nonneg"
        }
      ]
    },
    {
      "id": "spawner",
      "label": "Spawner",
      "draw": "generic",
      "description": "Child actors to spawn (num-lurkers).",
      "fields": [
        {
          "key": "og_num_lurkers",
          "label": "Lurkers to spawn",
          "type": "int",
          "default": -1,
          "note": "-1 leaves the engine default; 0+ overrides the spawn count.",
          "lump": {
            "key": "num-lurkers",
            "type": "int32"
          },
          "write_if": "if_nonneg"
        }
      ]
    },
    {
      "id": "notice-dist",
      "label": "Notice Distance",
      "draw": "generic",
      "description": "notice-dist lump: -1 = always active, >= 0 = needs eco within range.",
      "fields": [
        {
          "key": "og_notice_dist",
          "label": "Notice distance (m)",
          "type": "float",
          "default": -1.0,
          "note": "-1 = always active; >=0 = eco required within range.",
          "lump": {
            "key": "notice-dist",
            "type": "meters"
          }
        }
      ]
    },
    {
      "id": "battlecontroller",
      "label": "Battle Controller",
      "description": "battlecontroller.gc settings: intro camera (variant), lurkers, spawning, pickups, linked actors. Drawn by the Battle Controller panel.",
      "fields": [
        {
          "key": "og_bc_alive",
          "label": "Max alive at once",
          "type": "int",
          "default": 12,
          "min": 1,
          "max": 127,
          "section": "spawn",
          "note": "Stops spawning while this many lurkers are alive (max 127).",
          "lump": {
            "key": "num-lurkers",
            "type": "int32",
            "slot": 0
          },
          "write_if": "always"
        },
        {
          "key": "og_bc_total",
          "label": "Total to beat",
          "type": "int",
          "default": 35,
          "min": 1,
          "max": 32767,
          "section": "spawn",
          "note": "Lurkers to beat before it is done (max 32767). Very high (e.g. 1000): the spawn blockers must be destroyed instead.",
          "lump": {
            "key": "num-lurkers",
            "type": "int32",
            "slot": 1
          },
          "write_if": "always"
        },
        {
          "key": "og_bc_delay",
          "label": "Time between spawns (s)",
          "type": "float",
          "default": 0.1,
          "min": 0.0,
          "section": "spawn",
          "lump": {
            "key": "delay",
            "type": "float"
          },
          "write_if": "if_not_default"
        },
        {
          "key": "og_bc_drop",
          "label": "Normal drop",
          "type": "enum",
          "default": "eco-pill",
          "choices": "CratePickups",
          "section": "lurkers",
          "note": "Dropped by a lurker that doesn't drop its special eco.",
          "lump": {
            "key": "eco-info",
            "type": "eco-info-picker",
            "pairs_with": "og_bc_drop_amount"
          },
          "write_if": "always"
        },
        {
          "key": "og_bc_drop_amount",
          "label": "Normal drop amount",
          "type": "int",
          "default": 4,
          "min": 1,
          "max": 99,
          "section": "lurkers"
        },
        {
          "key": "og_bc_end_pickup",
          "label": "Spawn a pickup at the end",
          "type": "bool",
          "default": true,
          "section": "end",
          "note": "Power cell: spawns where the last lurker died (uses the Game Task). Other pickups: dropped by the last lurker."
        },
        {
          "key": "og_bc_final_pickup",
          "label": "End pickup",
          "type": "enum",
          "default": "fuel-cell",
          "section": "end",
          "choices": [
            {
              "id": "none",
              "value": "none",
              "label": "None"
            },
            {
              "id": "eco-yellow",
              "value": "eco-yellow",
              "label": "Yellow Eco"
            },
            {
              "id": "eco-red",
              "value": "eco-red",
              "label": "Red Eco"
            },
            {
              "id": "eco-blue",
              "value": "eco-blue",
              "label": "Blue Eco"
            },
            {
              "id": "eco-green",
              "value": "eco-green",
              "label": "Green Eco"
            },
            {
              "id": "money",
              "value": "money",
              "label": "Orb"
            },
            {
              "id": "fuel-cell",
              "value": "fuel-cell",
              "label": "Power Cell"
            },
            {
              "id": "eco-pill",
              "value": "eco-pill",
              "label": "Green Eco Pill"
            },
            {
              "id": "buzzer",
              "value": "buzzer",
              "label": "Scout Fly"
            },
            {
              "id": "eco-pill-random",
              "value": "eco-pill-random",
              "label": "Green Eco Pill (random)"
            }
          ],
          "visible_if": {
            "og_bc_end_pickup": true
          }
        },
        {
          "key": "og_bc_prespawn",
          "label": "Spawn lurkers before Jak arrives",
          "type": "bool",
          "default": false,
          "section": "other",
          "note": "Fills every spawn path as soon as the level loads (mode 1).",
          "lump": {
            "key": "mode",
            "type": "int32"
          },
          "write_if": "if_true"
        }
      ]
    },
    {
      "id": "game-task",
      "label": "Game Task",
      "description": "The actor's game task (the .jsonc actor \"game_task\"; engine: entity perm task — saved state, the cell it gives). Option \"eco-info\": \"cell-info\" / \"buzzer-info\" / \"pickup\" (crates: by contents) writes the task into eco-info. Option \"description\": the panel hint.",
      "fields": [
        {"key": "og_game_task", "label": "Game task", "type": "task", "default": "none",
         "note": "Custom: the task's name in the game-task enum, or a full expression in ( )."},
        {"key": "og_buzzer_index", "label": "Scout fly (1-7)", "type": "int", "default": 1, "min": 1, "max": 7,
         "note": "Which of the task's 7 scout flies this is.", "show-field": false, "export": false}
      ]
    },
    {
      "id": "movie-pos",
      "label": "Movie Position",
      "description": "movie-pos lump (collectables.gc): where a power cell plays its pickup animation, or where the cell from the last scout fly jumps; also read by muse. Cells given by another actor read it from that actor. A list: some actors pick an entry by index (pelican [1], sunken-pipegame [1] [2]). Cone empties in the Movie Position panel; W = their Z rotation (facing angle). movie-mask: victory animations the cell must not pick (bits 0-7; e.g. ones that clip a wall). Option \"description\": the panel hint.",
      "fields": [
        {"key": "og_movie_mask_0", "label": "No victory anim 1", "type": "bool", "default": false, "group": "movie-mask", "lump_bit": {"key": "movie-mask", "type": "uint32", "bit_value": 1}, "write_if": "if_true"},
        {"key": "og_movie_mask_1", "label": "No victory anim 2", "type": "bool", "default": false, "group": "movie-mask", "lump_bit": {"key": "movie-mask", "type": "uint32", "bit_value": 2}, "write_if": "if_true"},
        {"key": "og_movie_mask_2", "label": "No victory anim 3", "type": "bool", "default": false, "group": "movie-mask", "lump_bit": {"key": "movie-mask", "type": "uint32", "bit_value": 4}, "write_if": "if_true"},
        {"key": "og_movie_mask_3", "label": "No victory anim 4", "type": "bool", "default": false, "group": "movie-mask", "lump_bit": {"key": "movie-mask", "type": "uint32", "bit_value": 8}, "write_if": "if_true"},
        {"key": "og_movie_mask_4", "label": "No victory anim 5", "type": "bool", "default": false, "group": "movie-mask", "lump_bit": {"key": "movie-mask", "type": "uint32", "bit_value": 16}, "write_if": "if_true"},
        {"key": "og_movie_mask_5", "label": "No victory anim 6", "type": "bool", "default": false, "group": "movie-mask", "lump_bit": {"key": "movie-mask", "type": "uint32", "bit_value": 32}, "write_if": "if_true"},
        {"key": "og_movie_mask_6", "label": "No victory anim 7", "type": "bool", "default": false, "group": "movie-mask", "lump_bit": {"key": "movie-mask", "type": "uint32", "bit_value": 64}, "write_if": "if_true"},
        {"key": "og_movie_mask_7", "label": "No victory anim 8", "type": "bool", "default": false, "group": "movie-mask", "lump_bit": {"key": "movie-mask", "type": "uint32", "bit_value": 128}, "write_if": "if_true"}
      ]
    },
    {
      "id": "fact-options",
      "label": "Options",
      "description": "fact-options bits ('options' lump, engine/game/fact-h.gc). Every option is hidden by default; a parent or actor turns on the ones its code reads with \"show-field\": true, and \"highlight\": true lists it first.",
      "fields": [
        {
          "key": "og_fop_vent_blocked",
          "label": "Vent blocked",
          "type": "bool",
          "default": false,
          "note": "Vent starts blocked (opened by its blocker actor).",
          "lump_bit": {
            "key": "options",
            "type": "uint32",
            "bit_value": 1
          },
          "write_if": "if_true",
          "show-field": false
        },
        {
          "key": "og_fop_has_power_cell",
          "label": "Has power cell",
          "type": "bool",
          "default": false,
          "note": "Drops a power cell when killed (uses the actor's game task).",
          "lump_bit": {
            "key": "options",
            "type": "uint32",
            "bit_value": 2
          },
          "write_if": "if_true",
          "show-field": false
        },
        {
          "key": "og_fop_vent_valve",
          "label": "Vent valve",
          "type": "bool",
          "default": false,
          "note": "Vent controlled by a valve.",
          "lump_bit": {
            "key": "options",
            "type": "uint32",
            "bit_value": 4
          },
          "write_if": "if_true",
          "show-field": false
        },
        {
          "key": "og_fop_wrap_phase",
          "label": "Wrap phase",
          "type": "bool",
          "default": false,
          "note": "Sync phase wraps from 1 to 0 instead of mirroring (loops instead of ping-pong).",
          "lump_bit": {
            "key": "options",
            "type": "uint32",
            "bit_value": 8
          },
          "write_if": "if_true",
          "show-field": false,
          "legacy_key": "og_sync_wrap"
        },
        {
          "key": "og_fop_instant_collect",
          "label": "Instant collect",
          "type": "bool",
          "default": false,
          "note": "Pickup is collected instantly (balloon lurker, puffer).",
          "lump_bit": {
            "key": "options",
            "type": "uint32",
            "bit_value": 64
          },
          "write_if": "if_true",
          "show-field": false
        },
        {
          "key": "og_fop_skip_jump_anim",
          "label": "Skip jump animation",
          "type": "bool",
          "default": false,
