            {
              "key": "og_water_look",
              "label": "Look index",
              "type": "int",
              "default": -1,
              "show-field": false,
              "lump": {
                "key": "look",
                "type": "int32"
              },
              "write_if": "if_nonneg"
            },
            {
              "key": "og_water_toggle_period",
              "label": "On / off period (s)",
              "type": "float",
              "default": 8.0,
              "min": 0.01,
              "lump": {
                "key": "sync",
                "type": "float",
                "slot": 0
              },
              "write_if": "always",
              "export_if_visible": true,
              "visible_if": {
                "og_water_anim_look": [
                  "look-0",
                  "look-1",
                  "look-3",
                  "look-5",
                  "look-6"
                ]
              }
            },
            {
              "key": "og_water_toggle_phase",
              "label": "Phase (0-1)",
              "type": "float",
              "default": 0.0,
              "min": 0.0,
              "max": 1.0,
              "lump": {
                "key": "sync",
                "type": "float",
                "slot": 1
              },
              "write_if": "always",
              "export_if_visible": true,
              "visible_if": {
                "og_water_anim_look": [
                  "look-0",
                  "look-1",
                  "look-3",
                  "look-5",
                  "look-6"
                ]
              }
            },
            {
              "key": "og_water_toggle_percent",
              "label": "Electric part of the period (0-1)",
              "type": "float",
              "default": 0.3,
              "min": 0.0,
              "max": 1.0,
              "lump": {
                "key": "percent",
                "type": "float"
              },
              "write_if": "always",
              "export_if_visible": true,
              "visible_if": {
                "og_water_anim_look": [
                  "look-0",
                  "look-1",
                  "look-3",
                  "look-5",
                  "look-6"
                ]
              },
              "note": "0 = always electric, 1 = never (vanilla 0.25-0.5)."
            }
          ]
        }
      ]
    },
    {
      "etype": "swingpole",
      "label": "Swing Pole",
      "description": "Invisible pole Jak can swing on (the pole itself is level geometry). Spawns turned 90° on X (the game reads the pole direction from its local Y); turn it around Z to aim it. The arrows are one side of the pole (2 m).",
