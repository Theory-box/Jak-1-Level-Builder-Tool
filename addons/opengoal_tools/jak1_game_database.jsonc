    {
      "etype": "race-ring",
      "label": "Race Ring",
      "category": "Interactive Objects",
      "parent": "process-drawable",
      "code": "rolling-race-ring.o",
      "art_group": "race-ring-ag.go",
      "tpage_group": "Rolling",
      "glb": "levels/rolling/race-ring-lod0.glb",
      "shape": "CUBE",
      "description": "Chain of timed rings: jump through the first to start; each ring must be reached before its time or the chain resets. The last ring gives the task's cell. The ring itself is particles. Give it a path to make the whole chain from one actor (one ring per point).",
      "panels": [
        {
          "panel": "path",
          "rings": true,
          "description": "Optional: one ring per point (curve control points or waypoints), linked in order. Point Tilt = extra yaw, point Weight multiplies the time."
        },
        {
          "panel": "game-task",
          "description": "First and last ring: the chase's task. rolling-ring-chase-2 = blue rings."
        },
        {
          "panel": "movie-pos",
          "description": "Last ring: where the cell pickup plays."
        },
        {
          "panel": "actor-link",
          "slots": [
            {
              "lump_key": "next-actor",
              "slot": 0,
              "label": "Next ring (none = last ring)",
              "accepts": [
                "race-ring"
              ],
              "required": false
            },
            {
              "lump_key": "prev-actor",
              "slot": 0,
              "label": "Previous ring",
              "accepts": [
                "race-ring"
              ],
              "required": false
            },
            {
              "lump_key": "alt-actor",
              "slot": 0,
              "label": "First ring of this chase (none = this is the first ring)",
              "accepts": [
                "race-ring"
              ],
              "required": false
            }
          ]
        },
        {
          "panel": "custom-fields",
          "fields": [
            {
              "key": "og_ring_timeout",
              "label": "Time to reach (s)",
              "type": "float",
              "default": 8.0,
              "min": 0.0,
              "lump": {
                "key": "timeout",
                "type": "float"
              },
              "write_if": "always",
              "note": "Not used by the first ring. With a path: x each point's Radius."
            },
            {
              "key": "og_ring_rot",
              "label": "Extra yaw (deg)",
              "type": "float",
              "default": 0.0,
              "lump": {
                "key": "rotoffset",
                "type": "degrees"
              },
              "write_if": "if_nonzero",
              "note": "With a path: + each point's Tilt."
            },
            {
              "key": "og_ring_color",
              "label": "Ring colour",
              "type": "color",
              "default": [1.0, 0.0, 1.0],
              "lump": {
                "key": "ring-color",
                "type": "float"
              },
              "write_if": "always",
              "note": "Vanilla: purple (1, 0, 1), blue rings cyan (0, 1, 1)."
            },
            {
              "key": "og_ring_cell_anim",
              "label": "Cell animation (last ring)",
              "type": "enum",
              "default": "purple",
              "choices": [
                {"value": "purple", "label": "Purple rings animation", "lump_value": 0},
                {"value": "blue", "label": "Blue rings animation", "lump_value": 1},
                {"value": "none", "label": "None: the cell flies from the last ring to 2 m above its movie-pos", "lump_value": 2}
              ],
              "lump": {
                "key": "cell-anim",
                "type": "int32"
              },
              "write_if": "if_not_default",
              "note": "The animations end far below the ring (rolling's layout): the cell then flies 2 m above the last ring's movie-pos."
            },
            {
              "key": "og_ring_alt_task",
              "label": "First ring: active once this task is done",
              "type": "task",
              "default": "none",
              "lump": {
                "key": "alt-task",
                "type": "enum-uint32",
                "format": "(game-task {value})"
              },
              "write_if": "if_not_none"
            }
          ]
        }
      ]
    },
