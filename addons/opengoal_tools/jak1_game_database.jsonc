    {
      "etype": "oracle",
      "label": "Oracle",
      "category": "NPCs",
      "parent": "process-taskable",
      "code": "oracle.o",
      "art_group": "oracle-ag.go",
      "tpage_group": "Village1",
      "glb": "levels/village1/oracle-lod0.glb",
      "shape": "SINGLE_ARROW",
      "panels": [
        {
          "panel": "task-gated"
        },
        {
          "panel": "custom-fields",
          "fields": [
            {
              "key": "og_alt_task",
              "label": "Linked Task",
              "type": "task",
              "default": "none",
              "lump": {
                "key": "alt-task",
                "type": "enum-uint32",
                "format": "(game-task {value})"
              },
              "write_if": "if_not_none"
            }
          ],
          "show-panel": false
        }
      ],
      "description": "Two power cells in its eyes for 120 orbs each: its game task = right eye, Linked Task = left eye (use a vanilla pair: village1/2/3-oracle-money1 + -money2). Trading works, but its speeches are picked by the vanilla village Jak is in, so in a custom level it plays no cutscene (only its idle) before giving the cell."
    },
    {
      "etype": "minershort",
      "label": "Miner (Short)",
      "category": "NPCs",
      "parent": "process-taskable",
      "panels": [
        {
          "panel": "actor-link",
          "slots": [
            {
              "lump_key": "alt-actor",
              "slot": 0,
              "label": "Paired Miner (Tall) (required)",
              "accepts": [
                "minertall"
              ],
              "required": true
            }
          ]
        }
      ],
      "code": "miners.o",
      "art_group": "minershort-ag.go",
      "tpage_group": "Village3",
      "glb": "levels/village3/minershort-lod0.glb",
      "shape": "SINGLE_ARROW",
      "description": "Exported as a level subtype (subtypes/minershort.gc): its vanilla cutscenes play without the level commands that unloaded the custom level. Hidden: the cave-gnawers introduction starts with 'want-levels village3 maincave' (unloads the custom level). Otherwise vanilla village3-miner-money1-4 (90 orbs each) and snow-eggtop speeches with the tall miner. Needs its tall miner link (no null check). Needs a subtype: drop the level-load commands."
    },
