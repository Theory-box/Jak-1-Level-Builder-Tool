              "lump": {
                "key": "trans-offset",
                "type": "vector3m",
                "slot": 1
              },
              "write_if": "if_any_nonzero",
              "group": "path-offset"
            },
            {
              "key": "og_trans_offset_z",
              "label": "Z (m, = -Blender Y)",
              "type": "float",
              "default": 0.0,
              "lump": {
                "key": "trans-offset",
                "type": "vector3m",
                "slot": 2
              },
              "write_if": "if_any_nonzero",
              "group": "path-offset"
            }
          ]
        }
