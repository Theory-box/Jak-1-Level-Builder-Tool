    {
      "etype": "sage-bluehut",
      "label": "Samos (Blue Sage's Hut)",
      "category": "NPCs",
      "parent": "process-taskable",
      "panels": [
        {
          "panel": "actor-link",
          "slots": [
            {
              "lump_key": "alt-actor",
              "slot": 0,
              "label": "Keira (Blue Hut) (required)",
              "accepts": [
                "assistant-bluehut"
              ],
              "required": true
            }
          ]
        }
      ],
      "code": "sage-bluehut.o",
      "art_group": "sage-bluehut-ag.go",
      "tpage_group": "Village2",
      "glb": "levels/village2/sage-bluehut-lod0.glb",
      "shape": "SINGLE_ARROW",
      "description": "Vanilla rolling-plants and swamp-arm speeches (Keira joins in). Shown once village2-levitator's introduction is closed (Keira's Blue Hut speech) and until the sages are kidnapped. Needs its Keira link (read with no null check). Only talks while Jak is at game Z > -1554 m and X < 393.75 m."
    },
    {
      "etype": "flutflut-bluehut",
      "label": "Flut Flut (Blue Hut)",
      "category": "NPCs",
      "parent": "process-taskable",
      "code": "flutflut-bluehut.o",
      "art_group": "flutflut-bluehut-ag.go",
      "tpage_group": "Village2",
      "glb": "levels/village2/flutflut-bluehut-lod0.glb",
      "shape": "SINGLE_ARROW",
      "description": "Idle Flut Flut; never talks. Shown once village2-levitator's introduction is closed and the beach-flutflut cell is collected. Keira (Blue Hut) needs one in the level (she pulls it into her cutscenes)."
    },
    {
      "etype": "assistant-bluehut",
