            },
            {
              "key": "og_mc_rotspeed",
              "label": "Yaw speed (deg/s)",
              "type": "float",
              "default": 20.0,
              "lump": {
                "key": "rotspeed",
                "type": "degrees"
              },
              "write_if": "if_not_default"
            },
            {
              "key": "og_mc_tiltmin",
