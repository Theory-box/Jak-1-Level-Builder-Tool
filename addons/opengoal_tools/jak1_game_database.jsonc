    },
    {
      "etype": "energyhub",
      "label": "Energy Hub",
      "category": "Hidden",
      "parent": "process-drawable",
      "code": "lavatube-energy.o",
      "art_group": [
        "energyhub-ag.go",
        "energyarm-ag.go",
        "energyball-ag.go"
      ],
      "tpage_group": "Lavatube",
      "glb": "levels/lavatube/energyhub-lod0.glb",
      "shape": "CUBE",
      "description": "Hidden: crashed the game in a custom level. Spinning hub (place it on an energybase) that spawns 5 arms, each holding an energy ball; shoot all balls with yellow eco to stop it. Then it sends 'stop to alt-actor 0, 'open to alt-actor 1 and resolves the vanilla lavatube-balls task. Every frame it also holds alt-actor 2's model at 1.25x X/Z scale and fades lava palette 2. Likely crash cause: when fewer than 3 alt-actors are linked, the empty slots are 0 (not #f). Each frame the hub then writes through that 0 pointer.",
      "panels": [
        {
          "panel": "actor-link",
          "slots": [
            {
              "lump_key": "alt-actor",
              "slot": 0,
              "label": "Base (sent 'stop when all balls are shot)",
              "accepts": [
                "energybase",
                "any"
              ],
              "required": true
            },
            {
              "lump_key": "alt-actor",
              "slot": 1,
              "label": "Door (sent 'open when all balls are shot)",
              "accepts": [
                "energydoor",
                "any"
              ],
              "required": true
            },
            {
              "lump_key": "alt-actor",
              "slot": 2,
              "label": "Lava (model held at 1.25x X/Z scale every frame; must be a drawable actor)",
              "accepts": [
                "any"
              ],
              "required": true
            }
          ]
        }
      ]
    },
    {
      "etype": "energylava",
