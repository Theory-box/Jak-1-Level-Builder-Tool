  // ── Actors ──────────────────────────────────────────────────────
  "Actors": [
    {
      "etype": "babak",
      "label": "Babak (Lurker)",
      "category": "Enemies",
      "parent": "nav-enemy",
      "panels": [
        {"panel": "nav-mesh", "can-jump": true},{"panel": "custom-fields", "fields": [{"key": "og_nav_speed", "label": "Move speed (x)", "type": "float", "default": 1.0, "min": 0.0, "note": "Multiplies how fast the enemy moves when it walks / runs on the nav-mesh (fact-info-enemy speed, read by aligned nav-enemies). 1 = normal.", "lump": {"key": "speed", "type": "float"}, "write_if": "if_not_default"}]}],
      "description": "The babak is a type of lurker in The Precursor Legacy, Daxter, and Jak II. They are introduced as enemies, being the most common foot soldiers in Gol Acheron and Maia's army.",
      "art_group": "babak-ag.go",
      "tpage_group": "Beach",
      "code": "babak.o",
      "glb": "levels/beach/babak-lod0.glb"
    },
    {
      "etype": "battlecontroller",
      "label": "Battle Controller (Ambush)",
      "description": "Lurker ambush: when Jak comes within 30 m it spawns lurkers along its spawn paths until enough have been beaten. Variant = the intro camera.",
      "category": "Enemies",
      "parent": "process-drawable",
      "code": "battlecontroller.o",
      "shape": "SPHERE",
      "empty_size": 30.0,
      "panels": [
        {
          "panel": "nav-mesh",
          "fallback-sphere": true
        },
        {
          "panel": "activation",
          "fields": [
            {
              "key": "og_notice_top",
              "show-field": true,
              "export": true
            },
            {
              "key": "og_notice_bottom",
              "show-field": true,
              "export": true
            }
          ]
        },
        {
          "panel": "path",
          "required": true,
          "multi-path": true,
          "linear-only": true,
          "paths": [
            "patha",
            "pathb",
            "pathc",
            "pathd",
            "pathe",
            "pathf",
            "pathg",
            "pathh",
            "pathspawn"
          ],
          "description": "Main path (required): the lurkers' patrol — the game crashes without it. Spawn paths patha .. pathh (at least one, max 8): a lurker spawns at the first point and jumps along the rest. pathspawn: one lurker placed on each point at the start."
        },
        {
          "panel": "game-task",
          "description": "The task of the power cell it spawns at the end (or of the cell that turns this ambush off)."
        },
        {
          "panel": "movie-pos",
          "description": "Where the power cell it spawns at the end plays its animation (cone = facing)."
        },
        {
          "panel": "actor-link",
          "slots": [
            {
              "lump_key": "spawner-blocker-actor",
              "slot": 0,
              "label": "Spawn path blockers ([0] blocks patha, [1] pathb ...): once complete, that path stops spawning",
              "accepts": [
                "any"
              ],
              "required": false,
              "allow-multiple": true,
              "show-in": "battlecontroller"
            },
            {
              "lump_key": "spawner-trigger-actor",
              "slot": 0,
              "label": "Spawn path actors ([0] patha, [1] pathb ...): sent 'spawn when their path spawns",
              "accepts": [
                "any"
              ],
              "required": false,
              "allow-multiple": true,
              "show-in": "battlecontroller"
            },
            {
              "lump_key": "kill-actor",
              "slot": 0,
              "label": "Turned off while the ambush is on (performance)",
              "accepts": [
                "any"
              ],
              "required": false,
              "allow-multiple": true,
              "show-in": "battlecontroller"
            },
            {
              "lump_key": "trigger-actor",
              "slot": 0,
              "label": "Triggered when the ambush starts (keep doors shut, change the camera ...)",
              "accepts": [
                "any"
              ],
              "required": false,
              "allow-multiple": true,
              "show-in": "battlecontroller"
            },
            {
              "lump_key": "fade-actor",
              "slot": 0,
              "label": "Faded out when the ambush is over (e.g. stop an eco vent)",
