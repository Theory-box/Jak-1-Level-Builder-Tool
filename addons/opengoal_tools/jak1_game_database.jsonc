    {
      "etype": "sage-finalboss",
      "label": "Final Boss Sage (ending cutscenes)",
      "category": "NPCs",
      "parent": "process-taskable",
      "code": [
        "final-door.o",
        "sage-finalboss-part.o",
        "sage-finalboss.o"
      ],
      "art_group": [
        "green-sagecage-ag.go",
        "jak-white-ag.go",
        "robotboss-cinematic-ag.go",
        "silodoor-ag.go",
        "plat-eco-finalboss-ag.go"
      ],
      "tpage_group": "Final",
      "glb": "levels/finalboss/green-sagecage-lod0.glb",
      "shape": "CUBE",
      "description": "Hidden; plays the ending cutscenes once the robot boss is beaten (link it as the robot's slot 5): Daxter's sacrifice, then the outros and the credits (which end the game like vanilla). Cutscenes play around it, so place it like vanilla: from the robot (unrotated) X -228 m, Y -138 m, Z +59.5 m. Exported as a level subtype (subtypes/sage-finalboss.gc). Uses the vanilla finalboss-movies task."
    },
    {
      "etype": "sage",
      "label": "Samos (Sage's Hut)",
      "category": "NPCs",
      "parent": "process-taskable",
      "code": [
        "assistant.o",
        "sage.o"
      ],
      "art_group": [
        "sage-ag.go",
        "assistant-ag.go"
      ],
      "tpage_group": "Village1",
      "glb": "levels/village1/sage-lod0.glb",
      "shape": "SINGLE_ARROW",
      "description": "Exported as a level subtype (subtypes/sage.gc): its vanilla cutscenes play without the level commands that unloaded the custom level. Hidden: unsafe in a custom level. Talking plays Samos's vanilla speeches for intro / beach-ecorocks / misty-cannon, but most start with 'want-levels village1 beach|misty|training', which unloads the custom level mid-cutscene. With a non-'play boot it also closes the intro task and restarts at game-start (Geyser Rock). Needs a subtype: drop the level-load commands and the boot-message branch."
    },
    {
      "etype": "assistant",
      "label": "Keira (Sage's Hut)",
      "category": "NPCs",
      "parent": "process-taskable",
      "code": "assistant.o",
      "art_group": "assistant-ag.go",
      "tpage_group": "Village1",
      "glb": "levels/village1/assistant-lod0.glb",
      "shape": "SINGLE_ARROW",
      "description": "Exported as a level subtype (subtypes/assistant.gc): its vanilla cutscenes play without the level commands that unloaded the custom level. Hidden: Keira's introductions (jungle-eggtop blue eco switch, misty-bike race bike) start with 'want-levels village1 beach' and unload the custom level. Reminders are safe. Removes itself once firecanyon-assistant has started. Needs a subtype: drop the level-load commands."
    },
    {
      "etype": "bird-lady",
      "label": "Bird Lady (Village)",
      "category": "Hidden",
      "parent": "process-taskable",
      "code": "bird-lady.o",
      "art_group": "bird-lady-ag.go",
      "tpage_group": "Beach",
      "glb": "levels/beach/bird-lady-lod0.glb",
      "shape": "SINGLE_ARROW",
      "description": "Hidden: her beach-flutflut introduction starts with 'want-levels village1 beach' (unloads the custom level), and she only offers to talk while Jak is at game Z < -20 m (hard-coded). Removed once beach-flutflut's reminder stage is closed. Needs a subtype: drop level-load commands, target-above-threshold? -> #t."
    },
    {
      "etype": "bird-lady-beach",
      "label": "Bird Lady (Beach, Flut Flut hatch)",
      "category": "NPCs",
      "parent": "process-taskable",
      "code": [
        "beach-obs.o",
        "bird-lady-beach.o"
      ],
      "art_group": [
        "bird-lady-beach-ag.go",
        "flutflut-ag.go",
        "flutflutegg-ag.go"
      ],
      "tpage_group": "Beach",
      "glb": "levels/beach/bird-lady-beach-lod0.glb",
      "shape": "SINGLE_ARROW",
      "description": "Invisible until beach-flutflut is at its reward speech (vanilla: the flut flut egg was pushed off the cliff). Then she plays the hatching cutscene (with the flut flut and egg) and gives the beach-flutflut cell."
    },
    {
      "etype": "seagullflock",
      "label": "Seagull Flock",
      "category": "NPCs",
      "parent": "process",
      "code": [
        "air-h.o",
        "air.o",
        "seagull.o"
      ],
      "art_group": "seagull-ag.go",
      "tpage_group": "Beach",
      "glb": "levels/beach/seagull-lod0.glb",
      "shape": "CUBE",
      "panels": [
        {
          "panel": "game-task",
          "description": "beach-seagull (the flock also closes beach-seagull's reminder itself; its save state keeps how far they were chased)."
        },
        {
          "panel": "path",
          "required": true
        },
        {
          "panel": "actor-link",
          "slots": [
            {
              "lump_key": "next-actor",
              "slot": 0,
              "label": "Rock to drop (gets 'loading, then 'trigger; the flock waits until it is complete)",
              "accepts": [
                "any"
              ],
              "required": false
            }
          ]
        }
      ],
      "description": "21 seagulls at path point 0; walking up scares them on to points 1, 2, 3 (with Daxter's seagull hints), then to the end and, once the linked rock answers, they knock it down (vanilla lrocklrg). With no rock linked they wait at the end for good (no crash)."
    },
