;; The Fisher (Jungle) for custom levels.
;; - his task is the actor's own (Game Task panel); none = vanilla jungle-fishgame
;; - his introduction plays without its level commands (vanilla: want-levels village1
;;   jungle ..., which unload the custom level mid-cutscene)
;; - the minigame: Jak stands at the linked empty (fisher-stand: position, facing =
;;   its Z rotation) instead of vanilla jungle coordinates, and the camera is the
;;   linked camera (fisher-camera) instead of vanilla camera-152 (none: the normal
;;   camera). The fish still run down the fisher's own path (net at point 6.5).
;; - talks whatever the task (vanilla: only while the current task is jungle-fishgame)
(deftype __TYPE__ (fisher)
  ((strip-src basic 8)
   (strip-dst basic 8)
   (strip-cnt int32)
   (stand     vector :inline)
   (stand-yaw float)
   (has-stand symbol)
   (cam-name  string))
  (:states
   __TYPE__-playing))

(defun __TYPE__-level-cmd? ((cmd object))
  (or (= cmd 'want-levels) (= cmd 'display-level) (= cmd 'want-force-vis)
      (= cmd 'want-force-inside) (= cmd 'want-vis) (= cmd 'save)))

(defun __TYPE__-strip ((anim spool-anim))
  (let ((rev '())
        (out '())
        (it (-> anim command-list)))
    (while (not (null? it))
      (if (not (__TYPE__-level-cmd? (car (cdr (car it)))))
        (set! rev (cons (car it) rev)))
      (set! it (cdr it)))
    (while (not (null? rev))
      (set! out (cons (car rev) out))
      (set! rev (cdr rev)))
    (let ((n (new 'global 'spool-anim)))
      (set! (-> n name) (-> anim name))
      (set! (-> n index) (-> anim index))
      (set! (-> n parts) (-> anim parts))
      (set! (-> n priority) (-> anim priority))
      (set! (-> n owner) (-> anim owner))
      (set! (-> n command-list) (the-as pair out))
      n)))

(defmethod play-anim! ((this __TYPE__) (arg0 symbol))
  (let ((a (call-parent-method this arg0)))
    (cond
      ((or (not a) (not (type-type? (-> a type) spool-anim))) a)
      (else
       (dotimes (i (-> this strip-cnt))
         (if (= (-> this strip-src i) a) (return (-> this strip-dst i))))
       (let ((n (__TYPE__-strip (the-as spool-anim a))))
         (when (< (-> this strip-cnt) 8)
           (set! (-> this strip-src (-> this strip-cnt)) a)
           (set! (-> this strip-dst (-> this strip-cnt)) n)
           (+! (-> this strip-cnt) 1))
         n)))))

(defmethod get-art-elem ((this __TYPE__))
  (if (closed? (-> this tasks) (current-task (-> this tasks)) (task-status need-reminder))
    (-> this draw art-group data 7)
    (-> this draw art-group data 6)))

(defmethod process-taskable-method-43 ((this __TYPE__))
  (cond
    ((closed? (-> this tasks) (current-task (-> this tasks)) (task-status need-reminder))
     (when (ambient-control-method-10 (-> this ambient) (new 'stack-no-clear 'vector) (seconds 1) 122880.0 this)
       (let ((f0-2 (rand-float-gen)))
         (if (< 0.5 f0-2)
           (play-ambient (-> this ambient) "FIS-LO03" #f (-> this root trans))
           (play-ambient (-> this ambient) "FIS-LO05" #f (-> this root trans))))))
    (else
     (when (ambient-control-method-10 (-> this ambient) (new 'stack-no-clear 'vector) (seconds 30) 122880.0 this)
       (let ((f0-5 (rand-float-gen)))
         (cond
           ((< 0.875 f0-5) (play-ambient (-> this ambient) "FIS-LO01" #f (-> this root trans)))
           ((< 0.75 f0-5) (play-ambient (-> this ambient) "FIS-LO04" #f (-> this root trans)))
           ((< 0.625 f0-5) (play-ambient (-> this ambient) "FIS-AM01" #f (-> this root trans)))
           ((< 0.5 f0-5) (play-ambient (-> this ambient) "FIS-AM02" #f (-> this root trans)))
           ((< 0.375 f0-5) (play-ambient (-> this ambient) "FIS-AM03" #f (-> this root trans)))
           ((< 0.25 f0-5) (play-ambient (-> this ambient) "FIS-AM04" #f (-> this root trans)))
           ((< 0.125 f0-5) (play-ambient (-> this ambient) "FIS-AM05" #f (-> this root trans)))
           (else (play-ambient (-> this ambient) "FIS-AM06" #f (-> this root trans)))))))))

(defmethod target-above-threshold? ((this __TYPE__))
  (the-as symbol *target*))

(defbehavior __TYPE__-place-jak __TYPE__ ()
  "Keep Jak (and his net) on the fishing spot."
  (when (and *target* (-> self has-stand))
    (set! (-> *target* control trans quad) (-> self stand quad))
    (let ((m (-> *target* manipy)))
      (if m (set! (-> (the-as process-drawable (-> m 0)) root trans quad) (-> self stand quad))))))

(defstate enter-playing (__TYPE__)
  :virtual #t
  :trans
    (behavior ()
      (set-blackout-frames (seconds 0.017))
      (when (send-event *target* 'change-mode 'fishing self)
        (when (and *target* (-> self has-stand))
          (set-yaw-angle-clear-roll-pitch! (-> *target* control) (-> self stand-yaw))
          (rot->dir-targ! (-> *target* control)))
        (go __TYPE__-playing))))

(defstate __TYPE__-playing (__TYPE__)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (v0-2 object))
      (case message
        (('fisher-fish-die)
         (sound-play "fish-miss")
         (set! v0-2 (+ (-> self missed) (-> block param 0)))
         (set! (-> self missed) (the-as int v0-2))
         v0-2)
        (('fisher-fish-caught)
         (send-event *target* 'bounce)
         (set! v0-2 (+ (-> self caught) (-> block param 0)))
         (set! (-> self caught) (the-as int v0-2))
         v0-2)
        (('deadly) (go fisher-done))
        (('bad) (set! v0-2 (seekl (-> self caught) 0 10)) (set! (-> self caught) (the-as int v0-2)) v0-2)))
  :enter
    (behavior ()
      (set-setting! 'ambient-volume 'rel 50.0 0)
      (send-event *target* 'reset-pickup 'eco)
      (ja-channel-set! 0)
      (clear-collide-with-as (-> self root))
      (process-spawn-function process
        (lambda :behavior fisher-fish ()
          (logclear! (-> self mask) (process-mask pause))
          (loop
            (fisher-draw-display (the-as fisher (ppointer->process (-> self parent))))
            (suspend))
          (none))
        :to
        self)
      (if (-> self cam-name) (send-event *camera* 'change-to-entity-by-name (-> self cam-name)))
      (init! (-> self query) (the-as string #f) 40 150 25 #t (lookup-text! *common-text* (text-id quit) #f)))
  :exit
    (behavior ()
      (remove-setting! 'ambient-volume)
      (let* ((v1-2 *camera-other-matrix*)
             (a3-0 (-> *camera-combiner* inv-camera-rot))
             (a0-2 (-> a3-0 vector 0 quad))
             (a1-1 (-> a3-0 vector 1 quad))
             (a2-1 (-> a3-0 vector 2 quad))
             (a3-1 (-> a3-0 vector 3 quad)))
        (set! (-> v1-2 vector 0 quad) a0-2)
        (set! (-> v1-2 vector 1 quad) a1-1)
        (set! (-> v1-2 vector 2 quad) a2-1)
        (set! (-> v1-2 vector 3 quad) a3-1))
      (set! (-> *camera-other-fov* data) (-> *camera-combiner* fov))
      (set! (-> *camera-other-trans* quad) (-> *camera-combiner* trans quad))
      (set! (-> *camera-other-root* quad) (-> self root trans quad))
      (restore-collide-with-as (-> self root))
      (send-event *camera* 'blend-from-as-fixed)
      (send-event *camera* 'change-state *camera-base-mode* 0)
      (send-event *camera* 'clear-entity)
      0)
  :trans
    (behavior ()
      (spool-push *art-control* "fisher-resolution" 0 self -99.0)
      (spool-push *art-control* "fisher-reject" 0 self -99.0))
  :code
    (behavior ()
      (set! *display-profile* #f)
      (set! (-> self paddle) 0.5)
      (set! (-> self paddle-vel) 0.0)
      (set-time! (-> self start-time))
      (set! (-> self caught) 0)
      (set! (-> self missed) 0)
      (set! (-> self spawner) 0.5)
      (set! (-> self spawner-last) 0.5)
      (set! (-> self swing-time) 0)
      (set! (-> self block) -1)
      (set-time! (-> self block-time))
      (+! (-> self block) 1)
      (mem-copy! (the-as pointer (-> self params))
                 (the-as pointer (-> *fisher-params* (-> self difficulty) (-> self block)))
                 56)
      (set! (-> self ambient-big-one) 0)
      (set! (-> self ambient-steady) 0)
      (set! (-> self ambient-sagging) 0)
      (set! (-> self ambient-almost) 0)
      (loop
        (hide-hud-quick)
        (__TYPE__-place-jak)
        (fisher-game-update)
        (if (or (zero? (-> self params timeout))
                (>= (-> self missed) (-> *FISHER-bank* max-missed))
                (>= (-> self caught) (-> *FISHER-bank* max-caught)))
          (go fisher-done))
        (suspend)))
  :post
    (behavior ()
      (ja-post)))

(defstate play-anim (__TYPE__)
  :virtual #t
  :exit
    (behavior ()
      ;; vanilla (PC) fell back to a fixed jungle camera here
      (set! (-> self cur-trans-hook) nothing)
      ((-> (method-of-type process-taskable play-anim) exit))))

(defmethod init-from-entity! ((this __TYPE__) (arg0 entity-actor))
  (process-taskable-method-40 this arg0 *fisher-sg* 3 49 (new 'static 'vector :w 4096.0) 33)
  (set! (-> this strip-cnt) 0)
  (let ((task (-> arg0 extra perm task)))
    (set! (-> this tasks) (get-task-control (if (= task (game-task none)) (game-task jungle-fishgame) task))))
  ;; Jak's fishing spot (a linked empty: position + facing) and the minigame camera
  (let ((v (res-lump-struct arg0 'fisher-stand vector)))
    (set! (-> this has-stand) (if v #t #f))
    (when v
      (set! (-> this stand quad) (-> v quad))
      (set! (-> this stand-yaw) (-> v w))
      (set! (-> this stand w) 1.0)))
  (set! (-> this cam-name) (res-lump-struct arg0 'fisher-camera string))
  (set! (-> this path) (new 'process 'curve-control this 'path -1000000000.0))
  (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
  (let ((s5-0 (eval-path-curve-div! (-> this path) (-> this paddle-pos) 6.5 'interp))
        (s4-0 (path-control-method-12 (-> this path) (new-stack-vector0) 6.5)))
    (+! (-> s5-0 y) 2457.6)
    (vector-normalize! (vector-rotate-y! s4-0 s4-0 16384.0) (-> *FISHER-bank* width))
    (vector-! (the-as vector (-> this paddle-end)) s5-0 s4-0)
    (vector+! (the-as vector (&-> this stack 288)) s5-0 s4-0))
  (set! (-> this music) 'fishgame)
  (set! (-> this difficulty) (the-as int (-> this entity extra perm user-uint8 6)))
  (set! (-> this hard) #f)
  (set! (-> *FISHER-bank* max-caught) 200)
  (set! (-> this training) #f)
  (process-taskable-method-42 this)
  (none))

