;; Oracle for custom levels: two power cells in its eyes, each traded for orbs. Vanilla
;; picked its speeches by the vanilla village Jak was in (none in a custom level), needed a
;; vanilla oracle task pair (the talk prompt and the orb check were in their stages) and a
;; fixed 120-orb price. Here:
;; - right eye: its game task's cell, left eye: its Linked task's (alt-task lump); a cell
;;   is gone once its task is complete
;; - talking: the introduction once (saved, perm user-int8 0), then with Price orbs
;;   (price lump, default 120) it trades the next eye's cell, else the reminder
;; - Speeches (speeches lump: 1 Sandover, 2 Rock Village, 3 Volcanic Crater), Talk
;;   distance (talk-dist lump, default 8 m)
;; edits: oracle
(deftype __TYPE__ (oracle) ())

(defun __TYPE__-speeches ((this __TYPE__))
  (case (res-lump-value (-> this entity) 'speeches int :default (the-as uint128 1))
    ((2) 'village2)
    ((3) 'village3)
    (else 'village1)))

(defun __TYPE__-done? ((task int))
  (or (zero? task) (task-complete? *game-info* (the-as game-task task))))

(defun __TYPE__-next-eye ((this __TYPE__))
  "The task of the next cell to trade (right eye first), or 0."
  (cond
    ((not (__TYPE__-done? (the-as int (-> this first-task)))) (the-as int (-> this first-task)))
    ((not (__TYPE__-done? (the-as int (-> this second-task)))) (the-as int (-> this second-task)))
    (else 0)))

(defun __TYPE__-price ((this __TYPE__))
  (res-lump-float (-> this entity) 'price :default 120.0))

(defun __TYPE__-talkable? ((this __TYPE__))
  (nonzero? (__TYPE__-next-eye this)))

(defmethod play-anim! ((this __TYPE__) (arg0 symbol))
  (set! (-> this talk-message) (text-id press-to-talk))
  (let ((eye (__TYPE__-next-eye this)))
    (cond
      ((zero? (-> this entity extra perm user-int8 0))
       (when arg0
         (let ((v1-6 (-> this entity extra perm)))
           (logior! (-> v1-6 status) (entity-perm-status user-set-from-cstage))
           (set! (-> v1-6 user-int8 0) 1)))
       (case (__TYPE__-speeches this)
       (('village1) (new 'static 'spool-anim :name "oracle-intro-1" :index 9 :parts 5 :command-list '()))
       (('village2)
        (new 'static
             'spool-anim
             :name "oracle-intro-2"
             :index 11
             :parts 4
             :command-list
             '(
              (0 setting-reset ocean-off near)
              (399 setting-unset ocean-off))))
       (('village3) (new 'static 'spool-anim :name "oracle-intro-3" :index 13 :parts 4 :command-list '()))))
      ((and (nonzero? eye) (>= (the-as float (send-event *target* 'query 'pickup (pickup-type money))) (__TYPE__-price this)))
       (cond
         (arg0
          (set! (-> this cell-for-task) (the-as game-task eye))
          (send-event *target* 'get-pickup 5 (- (__TYPE__-price this)))
          (let ((a0-9 (handle->process (if (= eye (-> this first-task)) (-> this right-eye-cell) (-> this left-eye-cell)))))
            (if a0-9 (deactivate a0-9))))
         (else (set! (-> this will-talk) #t) (set! (-> this talk-message) (text-id press-to-trade-money-oracle))))
       (if (= eye (-> this first-task))
         (case (__TYPE__-speeches this)
          (('village1) (new 'static 'spool-anim :name "oracle-right-eye-1" :index 3 :parts 2 :command-list '()))
          (('village2) (new 'static 'spool-anim :name "oracle-right-eye-2" :index 5 :parts 2 :command-list '()))
          (('village3) (new 'static 'spool-anim :name "oracle-right-eye-3" :index 7 :parts 2 :command-list '())))
         (case (__TYPE__-speeches this)
          (('village1) (new 'static 'spool-anim :name "oracle-left-eye-1" :index 4 :parts 2 :command-list '()))
          (('village2) (new 'static 'spool-anim :name "oracle-left-eye-2" :index 6 :parts 2 :command-list '()))
          (('village3) (new 'static 'spool-anim :name "oracle-left-eye-3" :index 8 :parts 2 :command-list '())))))
      (else
       (set! (-> this skippable) #t)
       (case (__TYPE__-speeches this)
       (('village1) (new 'static 'spool-anim :name "oracle-reminder-1" :index 10 :parts 4 :command-list '()))
       (('village2) (new 'static 'spool-anim :name "oracle-reminder-2" :index 12 :parts 2 :command-list '()))
       (('village3) (new 'static 'spool-anim :name "oracle-reminder-3" :index 14 :parts 2 :command-list '())))))))

(defstate idle (__TYPE__)
  :virtual #t
  :exit
    (behavior ()
      (stop! (-> self sound))
      ((-> (method-of-type process-taskable idle) exit)))
  :trans
    (behavior ()
      (when (time-elapsed? (-> self state-time) (seconds 0.2))
        (logior! (-> self mask) (process-mask actor-pause))
        (process-entity-status! self (entity-perm-status bit-3) #f))
      (cond
        ((not *target*))
        ((not (-> self will-talk))
         (if (>= (- (-> *display* game-frame-counter) (-> self last-talk)) (seconds 10)) (set! (-> self will-talk) #t)))
        ((begin
           (process-taskable-method-46 self)
           (and (not (and (logtest? (-> *target* control unknown-surface00 flags) (surface-flags jump))
                          (not (logtest? (-> *target* control status) (cshape-moving-flags onsurf)))))
                (< (-> (target-pos 0) y) (+ 8192.0 (-> self root root-prim prim-core world-sphere y)))
                ;; og:preserve-this
                (less-than-hack (vector-vector-distance (target-pos 0) (the-as vector (-> self root root-prim prim-core))) (res-lump-float (-> self entity) 'talk-dist :default (meters 8)))
                (= (-> *level* loading-level) (-> *level* level-default))
                (not (movie?))
                (not (level-hint-displayed?))
                (none-reserved? *art-control*)
                (not *progress-process*)
                (and (not (handle->process (-> *game-info* other-camera-handle))) (close-anim-file! self))))
         (first-any (-> self tasks) #t)
         (when (target-above-threshold? self)
           (case (__TYPE__-talkable? self)
             ((#t)
              (kill-current-level-hint '() '(sidekick voicebox ambient) 'exit)
              (level-hint-surpress!)
              (hide-hud)
              (when (and (hud-hidden?) (can-grab-display? self))
                (let ((gp-1 (new 'stack 'font-context *font-default-matrix* 32 140 0.0 (font-color default) (font-flags shadow kerning))))
                  (let ((v1-57 gp-1)) (set! (-> v1-57 width) (the float 440)))
                  (let ((v1-58 gp-1)) (set! (-> v1-58 height) (the float 60)))
                  (let ((v1-59 gp-1)) (set! (-> v1-59 scale) 0.9))
                  (set! (-> gp-1 flags) (font-flags shadow kerning middle-vert large))
                  (print-game-text (lookup-text! *common-text* (-> self talk-message) #f) gp-1 #f 128 22))
                (when (and (cpad-pressed? 0 circle) (process-grab? *target*))
                  (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons circle))
                  (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons circle))
                  (send-event *target* 'trans 'save (-> self old-target-pos))
                  (go-virtual play-anim))))))))
      (if (= (-> *level* loading-level) (-> *level* level-default)) (process-taskable-method-33 self))
      (draw-npc-shadow self)
      (when (and (-> self been-kicked)
                 (and (not *progress-process*) (process-grab? *target*) (not (handle->process (-> *game-info* other-camera-handle)))))
        (set! (-> self been-kicked) #f)
        (send-event *target* 'trans 'save (-> self old-target-pos))
        (go-virtual play-anim))
      ((-> self cur-trans-hook))))

(defmethod init-from-entity! ((this __TYPE__) (arg0 entity-actor))
  (process-taskable-method-40 this arg0 *oracle-sg* 3 4 (new 'static 'vector :y -4096.0 :w 4096.0) -1)
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "oracle-sleep" :fo-max 50) (-> this root trans)))
  (set! (-> this first-task) (the-as uint (-> arg0 extra perm task)))
  (set! (-> this second-task) (res-lump-value arg0 'alt-task uint))
  (set! (-> this tasks) (get-task-control (the-as game-task (-> this first-task))))
  (set! (-> this right-eye-cell) (the-as handle #f))
  (set! (-> this left-eye-cell) (the-as handle #f))
  (logior! (-> this draw status) (draw-status skip-bones))
  (let ((s4-0 (new 'stack-no-clear 'vector))
        (s5-1 (lambda :behavior oracle ()
                (let* ((gp-0 (-> self root))
                       (v1-1 (if (and (nonzero? gp-0) (type-type? (-> gp-0 type) collide-shape)) gp-0))
                       (a1-1 (if v1-1 (-> v1-1 root-prim prim-core) (-> self root trans))))
                  (spawn (-> self part) (the-as vector a1-1)))
                0
                (none))))
    (ja-post)
    (when (not (task-closed? (the-as game-task (-> this first-task)) (task-status need-resolution)))
      (vector<-cspace! s4-0 (-> this node-list data 5))
      (set! (-> this right-eye-cell)
            (ppointer->handle (manipy-spawn s4-0 (-> this entity) *fuel-cell-sg* (new 'static 'vector :w 4915.2) :to this)))
      (send-event (handle->process (-> this right-eye-cell))
                  'eval
                  (lambda :behavior oracle ()
                    (let ((v0-0 (create-launch-control (-> *part-group-id-table* 63) self)))
                      (set! (-> self part) v0-0)
                      (the-as sparticle-launch-group v0-0))))
      (send-event (handle->process (-> this right-eye-cell)) 'trans-hook s5-1))
    (when (not (task-closed? (the-as game-task (-> this second-task)) (task-status need-resolution)))
      (vector<-cspace! s4-0 (-> this node-list data 6))
      (set! (-> this left-eye-cell)
            (ppointer->handle (manipy-spawn s4-0 (-> this entity) *fuel-cell-sg* (new 'static 'vector :w 4915.2) :to this)))
      (send-event (handle->process (-> this left-eye-cell))
                  'eval
                  (lambda :behavior oracle ()
                    (let ((v0-0 (create-launch-control (-> *part-group-id-table* 63) self)))
                      (set! (-> self part) v0-0)
                      (the-as sparticle-launch-group v0-0))))
      (send-event (handle->process (-> this left-eye-cell)) 'trans-hook s5-1)))
  (process-taskable-method-42 this)
  (none))
