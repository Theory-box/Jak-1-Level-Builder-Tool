;; Cave crystal (Spider Cave) for custom levels. Vanilla: hit, it glows for its timeout,
;; lighting palette slot (its place in the next-actor chain + 1) through the palette fade
;; controls, so the level's mood function must copy that slot (Moods tab: a Triggered slot
;; effect on it). Here (Actor Settings):
;;   palette-slot: 1 + the slot it lights (absent / 0: chain place + 1, as vanilla); with a
;;     slot set, several crystals can share one (the lit one nearest the camera wins)
;;   glow-strength: x the slot's strength (vanilla 1: a flash to 2, then 1)
;;   fade-out: seconds from lit to dark once its time is up (vanilla 0.7)
;;   crystal-flags: 1 no sage hints, 2 'trigger lights it too (a button's notify list ...)
;; The crystal light control (dark actors lit near lit crystals) is kept as vanilla.
;; edits: cavecrystal
(deftype __TYPE__ (cavecrystal)
  ((slot      int32)
   (strength  float)
   (fade-out  float)
   (cflags    uint32))
  (:states
   __TYPE__-active
   __TYPE__-idle))

(defun __TYPE__-glow ((this __TYPE__))
  "Vanilla compute-glow with its own fade out time."
  (set! (-> this prev-compute-glow-time) (-> *display* game-frame-counter))
  (let* ((gp-1 (max 1 (+ (- 1 (-> this activated-time)) (-> *display* game-frame-counter))))
         (f0-2 (/ (the float (mod (+ (current-time) (-> this glow-wf-offset)) (-> this glow-wf-period)))
                  (the float (-> this glow-wf-period))))
         (f30-1 (* 0.1 (cos (* 65536.0 f0-2)))))
    (cond
      ((>= (seconds 0.067) gp-1)
       (let ((v1-11 (* 0.05 (the float gp-1)))) (fmax 0.0 (fmin 2.0 (+ (* 2.0 v1-11) (* v1-11 f30-1))))))
      ((>= (seconds 0.6) gp-1)
       (let ((a2-0 (* 0.00625 (the float (+ gp-1 (seconds -0.067)))))) (fmin 2.0 (+ (lerp 2.0 1.0 a2-0) f30-1))))
      ((>= (-> this start-fade-time) gp-1) (+ 1.0 f30-1))
      (else
       (let ((v1-20 (fmin 1.0 (/ (the float (- gp-1 (-> this start-fade-time))) (fmax 1.0 (* 300.0 (-> this fade-out)))))))
         (fmax 0.0 (- (+ 1.0 (* (- 1.0 v1-20) f30-1)) v1-20)))))))

(defun __TYPE__-light ((this __TYPE__) (u float))
  "Vanilla light control update (method 9) without its fixed palette slot, then this one's slot."
  (let ((ctl *cavecrystal-light-control*)
        (id (-> this crystal-id)))
    (cavecrystal-light-control-method-12 ctl)
    (when (and (>= id 0) (< id 7))
      (let ((c (-> ctl crystal id)))
        (cond
          ((and (< 0.0 u) (>= 0.0 (-> c intensity)))
           (+! (-> ctl active-count) 1)
           (set! (-> c intensity) u)
           (set! (-> c crystal-handle) (process->handle this))
           (set! (-> c trans quad) (-> this root trans quad))
           (inc-intensities! ctl))
          ((and (>= 0.0 u) (< 0.0 (-> c intensity)))
           (+! (-> ctl active-count) -1)
           (set! (-> c intensity) 0.0)
           (inc-intensities! ctl))
          ((< 0.0 u) (set! (-> c intensity) u))))))
  (if (>= (-> this slot) 0)
      (set-fade! *palette-fade-controls* (-> this slot) (fmin 1.993 (* u (-> this strength)))
                 (vector-vector-distance (-> this root trans) (-> *math-camera* trans)) (-> this root trans))
      (set-fade! *palette-fade-controls* (+ (-> this crystal-id) 1) (fmin 1.993 (* u (-> this strength))) 0.0 (-> this root trans)))
  (none))

(defstate __TYPE__-idle (__TYPE__)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack) (go __TYPE__-active))
        (('trigger) (if (logtest? (-> self cflags) 2) (go __TYPE__-active)))))
  :trans
    (behavior ()
      (if (and (not (logtest? (-> self cflags) 1)) *target*
               (>= 40960.0 (vector-vector-distance (-> self root trans) (-> *target* control trans))))
        (level-hint-spawn (text-id darkcave-light-hint) "sksp0333" (the-as entity #f) *entity-pool* (game-task none)))
      (update-connected-crystals! self))
  :code
    (behavior ()
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      0))

(defstate __TYPE__-active (__TYPE__)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('attack)
         (let ((v1-1 (-> block param 2)))
           (cond
             ((!= v1-1 (-> self player-attack-id))
              (set! (-> self player-attack-id) v1-1)
              (set! (-> self activated-time) (-> *display* game-frame-counter))
              #t)
             (else #f))))
        (('trigger)
         (when (logtest? (-> self cflags) 2)
           (set! (-> self activated-time) (-> *display* game-frame-counter))
           #t))))
  :enter
    (behavior ()
      (logclear! (-> self mask) (process-mask actor-pause))
      (set! (-> self activated-time) (-> *display* game-frame-counter))
      (set! (-> self prev-compute-glow-time) (-> *display* game-frame-counter)))
  :exit
    (behavior ()
      (stop! (-> self sound))
      (if (not (-> self is-master?)) (logior! (-> self mask) (process-mask actor-pause))))
  :trans
    (behavior ()
      (let ((f30-0 (__TYPE__-glow self)))
        (set! (-> self glow-u) f30-0)
        (let ((gp-0 (new 'stack-no-clear 'vector))
              (f28-0 1.993))
          (let ((s5-0 (-> self draw color-mult)))
            (vector-! gp-0 (-> self on-color-mult) (-> self off-color-mult))
            (vector+*! s5-0 (-> self off-color-mult) gp-0 f30-0)
            (set! (-> s5-0 x) (fmax 0.0 (fmin (-> s5-0 x) f28-0)))
            (set! (-> s5-0 y) (fmax 0.0 (fmin (-> s5-0 y) f28-0)))
            (set! (-> s5-0 z) (fmax 0.0 (fmin (-> s5-0 z) f28-0)))
            (set! (-> s5-0 w) 1.0))
          (let ((s5-1 (-> self draw color-emissive)))
            (vector-! gp-0 (-> self on-color-emissive) (-> self off-color-emissive))
            (vector+*! s5-1 (-> self off-color-emissive) gp-0 f30-0)
            (set! (-> s5-1 x) (fmax 0.0 (fmin (-> s5-1 x) f28-0)))
            (set! (-> s5-1 y) (fmax 0.0 (fmin (-> s5-1 y) f28-0)))
            (set! (-> s5-1 z) (fmax 0.0 (fmin (-> s5-1 z) f28-0)))
            (set! (-> s5-1 w) 0.0)))
        (__TYPE__-light self (-> self glow-u))
        (update-connected-crystals! self)
        (when (>= 0.0 f30-0)
          (if (not (logtest? (-> self cflags) 1))
              (level-hint-spawn (text-id darkcave-light-end) "sksp0332" (the-as entity #f) *entity-pool* (game-task none)))
          (go __TYPE__-idle)))
      (update! (-> self sound)))
  :code
    (behavior ()
      (logior! (-> self mask) (process-mask sleep-code))
      (suspend)
      0))

(defmethod init-from-entity! ((this __TYPE__) (arg0 entity-actor))
  (set! (-> this glow-u) 0.0)
  (set! (-> this player-attack-id) (the-as uint 0))
  (set! (-> this last-updated-user-lighting) 0)
  (set-vector! (-> this off-color-mult) 0.0 0.0 0.0 1.0)
  (set-vector! (-> this off-color-emissive) 0.0 0.0 0.0 0.0)
  (set-vector! (-> this on-color-mult) 1.0 1.0 1.0 1.0)
  (set-vector! (-> this on-color-emissive) 0.0 0.0 0.0 0.0)
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum hit-by-others))))
    (let ((s3-0 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s3-0 prim-core collide-as) (collide-kind wall-object))
      (set! (-> s3-0 collide-with) (collide-kind target))
      (set! (-> s3-0 prim-core action) (collide-action solid))
      (set! (-> s3-0 prim-core offense) (collide-offense indestructible))
      (set! (-> s3-0 transform-index) 0)
      (set-vector! (-> s3-0 local-sphere) 0.0 19251.2 0.0 22118.4)
      (set-root-prim! s4-0 s3-0))
    (set! (-> s4-0 nav-radius) 4915.2)
    (backup-collide-with-as s4-0)
    (set! (-> this root) s4-0))
  (set! (-> this link) (new 'process 'actor-link-info this))
  (set! (-> this crystal-id) (actor-count-before (-> this link)))
  (set! (-> this is-master?) (= (-> this crystal-id) 3))
  (set! (-> this glow-wf-period) (rand-vu-int-range 225 375))
  (set! (-> this glow-wf-offset) (rand-vu-int-range 0 300))
  (if (-> this is-master?) (logclear! (-> this mask) (process-mask actor-pause)))
  (set! (-> this start-fade-time)
        (the-as time-frame (the int (* 300.0 (res-lump-float (-> this entity) 'timeout :default 8.0)))))
  (set! (-> this slot) (min 7 (+ -1 (the int (res-lump-value arg0 'palette-slot uint32)))))   ; 0 (absent): -1
  (set! (-> this strength) (res-lump-float arg0 'glow-strength :default 1.0))
  (set! (-> this fade-out) (res-lump-float arg0 'fade-out :default 0.7))
  (set! (-> this cflags) (res-lump-value arg0 'crystal-flags uint32))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *cavecrystal-sg* '())
  (nav-mesh-connect this (-> this root) (the-as nav-control #f))
  (set! (-> this draw color-mult quad) (-> this off-color-mult quad))
  (set! (-> this draw color-emissive quad) (-> this off-color-emissive quad))
  (ja-channel-push! 1 0)
  (let ((s5-1 (-> this skel root-channel 0)))
    (joint-control-channel-group-eval! s5-1 (the-as art-joint-anim (-> this draw art-group data 3)) num-func-identity)
    (set! (-> s5-1 frame-num) 0.0))
  (ja-post)
  (update-transforms! (-> this root))
  (__TYPE__-light this 0.0)
  (set! (-> this sound) (new 'process 'ambient-sound (static-sound-spec "crystal-on" :fo-max 80) (-> this root trans)))
  (go __TYPE__-idle)
  (none))
