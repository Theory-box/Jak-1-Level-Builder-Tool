;; edits: actor-light
;; place: shared
;; Actor Light: a custom actor (no vanilla one) that adds light to Jak (and Daxter)
;; and to its alt-actors, or takes it away (negative intensities). Every frame the
;; draw code (engine/draw/drawable.gc, dma-add-process-drawable, patched by the addon)
;; calls *actor-light-hook* with the light group the mood picked for a process; the
;; hook returns a changed copy (the mood / time of day lights are never written).
;;   strength: 1 within min-dist, 0 beyond max-dist (cylinder: horizontal distance
;;     only), measured from the light or the closest point of its path; 0 outside its
;;     volume (vol lump) if it has one; x the on / off fade.
;;   key light: from the light toward the actor (light-dir 0) or along the light's
;;     rotation (light-dir 1: its +Y, the Blender empty's +Z); several lights blend
;;     into one directional light (an unused slot, else merged with the weakest).
;;   ambient: colour x intensity added. Negative intensities darken instead.
;;   color-mode 1 (switch): the actor's own lights fade out by the strength, so at
;;     full strength it has only this light (several: they share it).
;;   shadow: the actor's shadow turns toward the light by strength x control-shadow.
;;   light-mode: 0 default on, 1 default off, 2 time of day, 3 time of day (default
;;     off); events 'on 'off 'trigger 'untrigger (toggle); trigger-actor dead /
;;     complete flips it once (time of day: 2 stays off, 3 may turn on).
;;   vis-dist: farther than this from the camera the light does nothing.
(deftype __TYPE__ (process-drawable)
  ((key-color   vector :inline)
   (amb-color   vector :inline)
   (min-dist    float)
   (max-dist    float)
   (vis-dist    float)
   (key-int     float)
   (amb-int     float)
   (shadow-amt  float)
   (fade-on     float)
   (fade-off    float)
   (hour-on     float)
   (hour-off    float)
   (fade        float)
   (dir-mode    uint32)
   (light-mode  uint32)
   (flags       uint32)
   (switch      symbol)
   (switch-init symbol)
   (dead-done   symbol)
   (active      symbol)
   (trigger     entity-actor)
   (alt-count   int32)
   (alt         entity-actor 16))
  (:states
   __TYPE__-idle))

;; flags
(defconstant __TYPE__-affect-jak 1)
(defconstant __TYPE__-cylinder 2)
(defconstant __TYPE__-has-vol 4)
(defconstant __TYPE__-has-path 8)
(defconstant __TYPE__-switch 16)

;; the active lights (handles: processes can move in memory), kept across level loads
(define-perm *__TYPE__-list* (pointer handle) (the-as (pointer handle) (malloc 'global 256)))
(define-perm *__TYPE__-count* int 0)

(defun __TYPE__-point ((this __TYPE__) (pos vector) (out vector))
  "The light's point for pos: the closest point of its path, else its position."
  (cond
    ((logtest? (-> this flags) __TYPE__-has-path)
     (let* ((p (-> this path))
            (n (-> p curve num-cverts))
            (ab (new 'stack-no-clear 'vector))
            (tmp (new 'stack-no-clear 'vector))
            (best 0.0))
       (set! (-> out quad) (-> p cverts 0 quad))
       (set! best (vector-vector-distance-squared pos out))
       (dotimes (i (+ n -1))
         (let ((a (-> p cverts i))
               (b (-> p cverts (+ i 1))))
           (vector-! ab b a)
           (let ((l2 (vector-dot ab ab)))
             (when (< 0.0 l2)
               (vector-! tmp pos a)
               (vector+float*! tmp a ab (fmax 0.0 (fmin 1.0 (/ (vector-dot tmp ab) l2))))
               (let ((d2 (vector-vector-distance-squared pos tmp)))
                 (when (< d2 best)
                   (set! best d2)
                   (set! (-> out quad) (-> tmp quad))))))))))
    (else (set! (-> out quad) (-> this root trans quad))))
  out)

(defun __TYPE__-strength ((this __TYPE__) (pos vector) (pt vector))
  "0 - 1 at pos (pt: the light's point for pos, set here)."
  (__TYPE__-point this pos pt)
  (let* ((dx (- (-> pos x) (-> pt x)))
         (dy (if (logtest? (-> this flags) __TYPE__-cylinder) 0.0 (- (-> pos y) (-> pt y))))
         (dz (- (-> pos z) (-> pt z)))
         (d (sqrtf (+ (* dx dx) (* dy dy) (* dz dz)))))
    (cond
      ((and (logtest? (-> this flags) __TYPE__-has-vol) (not (point-in-vol? (-> this vol) pos))) 0.0)
      ((>= d (-> this max-dist)) 0.0)
      ((or (<= d (-> this min-dist)) (>= (-> this min-dist) (-> this max-dist))) 1.0)
      (else (/ (- (-> this max-dist) d) (- (-> this max-dist) (-> this min-dist)))))))

(defun __TYPE__-to-light ((this __TYPE__) (pos vector) (pt vector) (out vector))
  "Unit vector from pos toward the light."
  (cond
    ((= (-> this dir-mode) 1)
     (vector-orient-by-quat! out (new 'static 'vector :y 1.0) (-> this root quat)))
    (else
     (vector-! out pt pos)
     (if (< (vector-length out) 1.0) (set-vector! out 0.0 1.0 0.0 0.0))))
  (set! (-> out w) 0.0)
  (vector-normalize! out 1.0))

(defun __TYPE__-affects? ((this __TYPE__) (proc process-drawable) (jak symbol))
  (if jak
      (logtest? (-> this flags) __TYPE__-affect-jak)
      (let ((e (-> proc entity))
            (hit #f))
        (when e
          (dotimes (i (-> this alt-count))
            (if (= e (-> this alt i)) (set! hit #t))))
        hit)))

(defun __TYPE__-hook ((proc process-drawable) (src light-group) (dst light-group))
  "Called by the draw code for every drawn process: src with the actor lights added
  (a copy in dst), or src itself when none reach it."
  (let ((key-dir (new 'stack-no-clear 'vector))
        (key-col (new 'stack-no-clear 'vector))
        (amb (new 'stack-no-clear 'vector))
        (sh-dir (new 'stack-no-clear 'vector))
        (pt (new 'stack-no-clear 'vector))
        (to-light (new 'stack-no-clear 'vector))
        (dark-key 1.0)
        (dark-amb 1.0)
        (sh-w 0.0)
        (sw 0.0)
        (add-amb #f)
        (hit #f)
        (jak (the-as symbol (and *target*
                                 (or (= proc *target*)
                                     (and (-> *target* sidekick) (= proc (ppointer->process (-> *target* sidekick))))))))
        (pos (new 'stack-no-clear 'vector)))
    ;; Daxter (the sidekick) never moves his own root: he gets Jak's light at Jak's position
    (set! (-> pos quad) (-> (if jak (-> *target* root trans) (-> proc root trans)) quad))
    (vector-reset! key-dir)
    (vector-reset! key-col)
    (vector-reset! amb)
    (vector-reset! sh-dir)
    (dotimes (i *__TYPE__-count*)
      (let ((l (the-as __TYPE__ (handle->process (-> *__TYPE__-list* i)))))
        (when (and l (-> l active) (__TYPE__-affects? l proc jak))
          (let ((s (* (-> l fade) (__TYPE__-strength l pos pt))))
            (when (< 0.0 s)
              (set! hit #t)
              (if (logtest? (-> l flags) __TYPE__-switch) (+! sw s))
              (__TYPE__-to-light l pos pt to-light)
              (let ((k (* s (-> l key-int))))
                (if (< k 0.0)
                    (set! dark-key (* dark-key (fmax 0.0 (+ 1.0 k))))
                    (when (< 0.0 k)
                      (vector+float*! key-dir key-dir to-light k)
                      (vector+float*! key-col key-col (-> l key-color) k))))
              (let ((a (* s (-> l amb-int))))
                (if (< a 0.0)
                    (set! dark-amb (* dark-amb (fmax 0.0 (+ 1.0 a))))
                    (when (< 0.0 a)
                      (set! add-amb #t)
                      (vector+float*! amb amb (-> l amb-color) a))))
              (when (< 0.0 (-> l shadow-amt))
                (let ((w (* s (-> l shadow-amt))))
                  (vector+float*! sh-dir sh-dir to-light w)
                  (+! sh-w w))))))))
    (cond
      ((not hit) src)
      (else
       (quad-copy! (the-as pointer dst) (the-as pointer src) 12)
       ;; switch lights: the actor's own light fades out
       (when (< 0.0 sw)
         (let ((f (fmax 0.0 (- 1.0 sw))))
           (dotimes (j 4)
             (set! (-> dst lights j levels x) (* f (-> dst lights j levels x))))))
       (when (< dark-key 1.0)
         (dotimes (j 3)
           (set! (-> dst lights j levels x) (* dark-key (-> dst lights j levels x)))))
       (when (< dark-amb 1.0)
         (set! (-> dst ambi levels x) (* dark-amb (-> dst ambi levels x))))
       (when add-amb
         (vector-float*! (-> dst ambi color) (-> dst ambi color) (-> dst ambi levels x))
         (vector+! (-> dst ambi color) (-> dst ambi color) amb)
         (set! (-> dst ambi color w) 1.0)
         (set! (-> dst ambi levels x) 1.0))
       ;; key light: into an unused directional light, else merged with the weakest
       (let ((e (vector-length key-dir)))
         (when (< 0.0 e)
           (vector-normalize! key-dir 1.0)
           (let ((slot 0)
                 (low 0.0))
             (dotimes (j 3)
               (let* ((lj (-> dst lights j))
                      (v (* (-> lj levels x) (+ (-> lj color x) (-> lj color y) (-> lj color z)))))
                 (when (or (zero? j) (< v low))
                   (set! slot j)
                   (set! low v))))
             (let ((ls (-> dst lights slot)))
               (cond
                 ((<= low 0.0)
                  (set! (-> ls direction quad) (-> key-dir quad))
                  (set! (-> ls color quad) (-> key-col quad)))
                 (else
                  (let ((d (new 'stack-no-clear 'vector)))
                    (vector-float*! d (-> ls direction) (/ low 3.0))
                    (vector+float*! d d key-dir e)
                    (if (< 0.0 (vector-length d)) (vector-normalize! d 1.0) (set! (-> d quad) (-> key-dir quad)))
                    (set! (-> ls direction quad) (-> d quad)))
                  (vector-float*! (-> ls color) (-> ls color) (-> ls levels x))
                  (vector+! (-> ls color) (-> ls color) key-col)))
               (set! (-> ls direction w) 0.0)
               (set! (-> ls color w) 1.0)
               (set! (-> ls levels x) 1.0)))))
       ;; shadow: from the time of day shadow toward the light (vanilla clamps it to
       ;; at most ~25 degrees from straight down, like the mood light zones)
       (let ((sc (-> proc draw shadow-ctrl)))
         (when (and (< 0.0 sh-w) sc (nonzero? sc))
           (let ((v (new 'stack-no-clear 'vector))
                 (base (-> *time-of-day-context* current-shadow)))
             (vector-normalize! sh-dir 1.0)
             (set-vector! v (- (-> sh-dir x)) (- (-> sh-dir y)) (- (-> sh-dir z)) 0.0)
             (when (< (-> sh-dir y) 0.9063)
               (let ((h (sqrtf (+ (* (-> v x) (-> v x)) (* (-> v z) (-> v z))))))
                 (when (< 0.0 h)
                   (set! (-> v x) (* (-> v x) (/ 0.4226 h)))
                   (set! (-> v z) (* (-> v z) (/ 0.4226 h))))
                 (set! (-> v y) -0.9063)))
             (let ((t (fmin 1.0 sh-w)))
               (set! (-> v x) (+ (-> base x) (* t (- (-> v x) (-> base x)))))
               (set! (-> v y) (+ (-> base y) (* t (- (-> v y) (-> base y)))))
               (set! (-> v z) (+ (-> base z) (* t (- (-> v z) (-> base z))))))
             (set! (-> v w) 0.0)
             (vector-normalize! v 1.0)
             (set! (-> sc settings shadow-dir x) (-> v x))
             (set! (-> sc settings shadow-dir y) (-> v y))
             (set! (-> sc settings shadow-dir z) (-> v z)))))
       dst))))

(defun __TYPE__-in-hours? ((this __TYPE__))
  (let ((t (-> *time-of-day-context* time))
        (on (-> this hour-on))
        (off (-> this hour-off)))
    (if (<= on off)
        (and (>= t on) (< t off))
        (or (>= t on) (< t off)))))

(defstate __TYPE__-idle (__TYPE__)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('on) (set! (-> self switch) #t))
        (('off) (set! (-> self switch) #f))
        (('trigger 'untrigger) (set! (-> self switch) (not (-> self switch))))))
  :code
    (behavior ()
      (loop
        ;; trigger-actor dead / complete: flips the light once
        (let ((tr (-> self trigger)))
          (when (and tr (not (-> self dead-done))
                     (logtest? (-> tr extra perm status) (entity-perm-status dead complete)))
            (set! (-> self dead-done) #t)
            (set! (-> self switch) (not (-> self switch-init)))))
        (let ((on (-> self switch))
              (dt (seconds-per-frame)))
          (if (>= (-> self light-mode) 2) (set! on (and on (__TYPE__-in-hours? self))))
          (set! (-> self fade)
                (if on
                    (if (< 0.0 (-> self fade-on)) (fmin 1.0 (+ (-> self fade) (/ dt (-> self fade-on)))) 1.0)
                    (if (< 0.0 (-> self fade-off)) (fmax 0.0 (- (-> self fade) (/ dt (-> self fade-off)))) 0.0))))
        (set! (-> self active)
              (and (< 0.0 (-> self fade))
                   (let ((pt (new 'stack-no-clear 'vector)))
                     (__TYPE__-point self (-> *math-camera* trans) pt)
                     (< (vector-vector-distance pt (-> *math-camera* trans)) (-> self vis-dist)))))
        ;; set every frame: a level unloading clears it (its copy of the code goes away)
        (set! *actor-light-hook* __TYPE__-hook)
        (suspend))))

(defmethod deactivate ((this __TYPE__))
  (let ((h (process->handle this)))
    (dotimes (i *__TYPE__-count*)
      (when (= (-> *__TYPE__-list* i) h)
        (+! *__TYPE__-count* -1)
        (set! (-> *__TYPE__-list* i) (-> *__TYPE__-list* *__TYPE__-count*)))))
  (set! *actor-light-hook* (the-as (function process-drawable light-group light-group light-group) #f))
  ((method-of-type process-drawable deactivate) this)
  (none))

(defmethod init-from-entity! ((this __TYPE__) (arg0 entity-actor))
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this min-dist) (res-lump-float arg0 'min-dist :default 20480.0))
  (set! (-> this max-dist) (res-lump-float arg0 'max-dist :default 40960.0))
  (set! (-> this vis-dist) (res-lump-float arg0 'vis-dist :default 409600.0))
  (set! (-> this key-int) (res-lump-float arg0 'key-intensity :default 1.0))
  (set! (-> this amb-int) (res-lump-float arg0 'ambient-intensity :default 0.5))
  (set! (-> this shadow-amt) (res-lump-float arg0 'control-shadow :default 0.5))
  (let ((c (res-lump-data arg0 'key-color (pointer float))))
    (if c
        (set-vector! (-> this key-color) (-> c 0) (-> c 1) (-> c 2) 1.0)
        (set-vector! (-> this key-color) 1.0 1.0 1.0 1.0)))
  (let ((c (res-lump-data arg0 'ambient-color (pointer float))))
    (if c
        (set-vector! (-> this amb-color) (-> c 0) (-> c 1) (-> c 2) 1.0)
        (set-vector! (-> this amb-color) 1.0 1.0 1.0 1.0)))
  (let ((f (res-lump-data arg0 'fade-time (pointer float))))
    (set! (-> this fade-on) (if f (-> f 0) 1.0))
    (set! (-> this fade-off) (if f (-> f 1) 1.0)))
  (let ((f (res-lump-data arg0 'hours (pointer float))))
    (set! (-> this hour-on) (if f (-> f 0) 18.0))
    (set! (-> this hour-off) (if f (-> f 1) 8.0)))
  (set! (-> this dir-mode) (res-lump-value arg0 'light-dir uint32))
  (set! (-> this light-mode) (res-lump-value arg0 'light-mode uint32))
  ;; light-flags: 1 = not Jak, 2 = cylinder
  (let ((lf (res-lump-value arg0 'light-flags uint32)))
    (set! (-> this flags)
          (the-as uint (logior (if (logtest? lf 1) 0 __TYPE__-affect-jak) (if (logtest? lf 2) __TYPE__-cylinder 0)))))
  (if (= (res-lump-value arg0 'color-mode uint32) 1) (logior! (-> this flags) __TYPE__-switch))
  (set! (-> this switch-init) (or (= (-> this light-mode) 0) (= (-> this light-mode) 2)))
  (set! (-> this switch) (-> this switch-init))
  (set! (-> this dead-done) #f)
  (set! (-> this active) #f)
  (set! (-> this fade) (if (-> this switch) 1.0 0.0))
  (set! (-> this trigger) (entity-actor-lookup arg0 'trigger-actor 0))
  (set! (-> this alt-count) (min 16 (entity-actor-count arg0 'alt-actor)))   ;; Lit actors: 16 max
  (dotimes (i (-> this alt-count))
    (set! (-> this alt i) (entity-actor-lookup arg0 'alt-actor i)))
  (when (res-lump-data arg0 'path pointer)
    (set! (-> this path) (new 'process 'path-control this 'path 0.0))
    (if (< 0 (-> this path curve num-cverts)) (logior! (-> this flags) __TYPE__-has-path)))
  (set! (-> this vol) (new 'process 'vol-control this))
  (if (< 0 (-> this vol pos-vol-count)) (logior! (-> this flags) __TYPE__-has-vol))
  (when (< *__TYPE__-count* 32)
    (set! (-> *__TYPE__-list* *__TYPE__-count*) (process->handle this))
    (+! *__TYPE__-count* 1))
  (go __TYPE__-idle)
  (none))
