;; Race ring for custom levels (vanilla: rolling-race-ring.gc). This child:
;;   - 'ring-color [r g b] (0-1): the ring particles' colour, per ring
;;     (vanilla: purple, or cyan for rolling-ring-chase-2). Own copies of the
;;     ring particles (part ids 3500-3511, groups 1000-1002); the colour is
;;     written into them before each spawn, like vanilla does for the facing.
;;   - 'cell-anim on the last ring: 0 purple-ring cell animation
;;     (race-ring-anim), 1 blue-ring one (race-ring-second-anim), 2 none: the
;;     cell appears at the last ring and flies 2 m above the ring's movie-pos. The
;;     vanilla animations end at a fixed rolling spot (far, below the ring),
;;     so with a movie-pos the cell flies there after them too.
;;   - the rolling-only hint dialogue is left out (the fail stinger stays).
(deftype __TYPE__ (race-ring)
  ((color     vector :inline)
   (cell-anim int32))
  (:states
   __TYPE__-active
   __TYPE__-idle
   __TYPE__-wait))

(defpartgroup __TYPE__-ring
  :id 1000
  :linger-duration (seconds 0)
  :bounds (static-bspherem 0 0 0 8)
  :parts
  ((sp-item 3500 :fade-after (meters 100) :falloff-to (meters 100))
   (sp-item 3501 :fade-after (meters 80))
   (sp-item 3502 :flags (is-3d))
   (sp-item 3503 :flags (is-3d))))

