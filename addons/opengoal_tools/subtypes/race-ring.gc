   (:r 64.0 1 64.0)
   (:g 64.0 1 64.0)
   (:b 64.0 1 64.0)
   (:a 64.0)
   (:rotvel-z (degrees -0.2) (degrees 0.4))
   (:fade-a -1.4222221)
   (:timer (seconds 0.14))
   (:flags (bit2 bit3))
   (:conerot-x (degrees 0) (degrees 360))
   (:conerot-radius (meters 4.5))
   (:rotate-y (degrees 0))))

