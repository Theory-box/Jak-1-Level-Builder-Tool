;; Periscope (Jungle eco beam) for custom levels. On target, vanilla played a camera
;; shot picked by the periscope's vanilla name from a junglecam-1 entity (crashing
;; without one) and advanced jungle-lurkerm. Here (Actor Settings):
;; - Beam shot (beam-shot lump): 0 none (Jak is free at once), 1 a linked CAMERA_
;;   (beam-camera: Camera time to the next piece, then Hold time on it), 2-7 a vanilla junglecam shot
;;   (tower1-5, beamcam) played from the Shot origin empty (shot-origin; none: the
;;   periscope).
;;   A linked camera looks from this periscope's top to the next piece in Camera time,
;;   then holds on it (hold-time); the beam cell pops out as the hold starts.
;; - Beam cell (beam-cell lump): its task's cell pops out at the beam's end near the end
;;   of the shot and jumps to movie-pos 0.
;; - Its task (Game Task panel): need-reminder closes once every periscope of the
;;   chain is on target (vanilla jungle-lurkerm). None: no task.
;; edits: periscope
(deftype __TYPE__ (periscope)
  ((cell handle))
  (:states
   __TYPE__-activate
   __TYPE__-idle
   __TYPE__-player-control
   __TYPE__-wait-for-player
   __TYPE__-wait-for-power-input))

(defbehavior __TYPE__-beam-shot __TYPE__ ()
  "The vanilla junglecam shot picked in Blender (none: no shot); its handle."
  (let ((v1-1 (the-as int (res-lump-value (-> self entity) 'beam-shot int :default (the-as uint128 0))))
        (s5-0 (new 'stack-no-clear 'vector)))
    (let ((v1-3 (res-lump-struct (-> self entity) 'shot-origin vector)))
      (set! (-> s5-0 quad) (-> (if v1-3 v1-3 (-> self root trans)) quad))
      (set! (-> s5-0 w) 1.0))
    (if (< v1-1 2)
      (the-as handle #f)
      (ppointer->handle (process-spawn pov-camera s5-0 *junglecam-sg*
                                       (case v1-1
                                         ((2) "tower1")
                                         ((3) "tower2")
                                         ((4) "tower3")
                                         ((5) "tower4")
                                         ((6) "tower5")
                                         (else "beamcam"))
                                       0 #f '() :to self)))))

(defbehavior __TYPE__-spawn-cell __TYPE__ ()
  "Beam cell: its task's cell pops out at the beam's end and jumps to movie-pos 0 (once)."
  (let ((task (-> self entity extra perm task)))
    (when (and (nonzero? (res-lump-value (-> self entity) 'beam-cell uint128))
               (!= task (game-task none))
               (not (task-complete? *game-info* task))
               (not (handle->process (-> self cell))))
      (let ((v1-6 (birth-pickup-at-point (-> self next-reflector-trans) (pickup-type fuel-cell) (the float task) #f self (the-as fact-info #f))))
        (when v1-6
          (set! (-> self cell) (ppointer->handle v1-6))
          (send-event (ppointer->process v1-6) 'movie-pos 0)
          (let ((a0-9 (res-lump-struct (-> self entity) 'movie-pos vector)))
            (if a0-9 (send-event (ppointer->process v1-6) 'jump a0-9)))))))
  0)

(defbehavior __TYPE__-beam-camera __TYPE__ ()
  "Beam shot 1: the linked camera, Jak waiting: its look moves from this periscope's top
to the next piece in Camera time, then stays on it for Hold time; the beam cell pops out
as the hold starts."
  (let ((cam (res-lump-struct (-> self entity) 'beam-camera string)))
    (when (and cam (= (res-lump-value (-> self entity) 'beam-shot int :default (the-as uint128 0)) 1) (process-grab? *target*))
      (camera-change-to cam 0 #f)
      ;; the camera follows a skeleton's root joint: a tiny stand-in moved along the beam
      (let ((gp-1 (manipy-spawn (-> self reflector-trans) (-> self entity) *fuel-cell-sg* #f :to self))
            (s5-0 (current-time))
            (f28-0 (fmax 1.0 (* 300.0 (res-lump-float (-> self entity) 'camera-time :default 2.0))))
            (f30-0 (* 300.0 (res-lump-float (-> self entity) 'hold-time :default 2.0)))
            (s4-0 (new 'stack-no-clear 'vector)))
        (send-event (ppointer->process gp-1) 'eval (lambda :behavior manipy () (set-vector! (-> self root scale) 0.001 0.001 0.001 1.0)))
        (send-event *camera* 'change-target (ppointer->process gp-1))
        (until (time-elapsed? s5-0 (the int (+ f28-0 f30-0)))
          (vector-lerp! s4-0 (-> self reflector-trans) (-> self next-reflector-trans)
                        (fmin 1.0 (/ (the float (- (current-time) s5-0)) f28-0)))
          (send-event (ppointer->process gp-1) 'trans s4-0)
          (if (time-elapsed? s5-0 (the int f28-0)) (__TYPE__-spawn-cell))
          (suspend))
        (send-event *camera* 'change-target *target*)
        (deactivate (ppointer->process gp-1)))
      (camera-change-to (the-as string 'base) 150 #f)
      (process-release? *target*)))
  0)

(defstate __TYPE__-idle (__TYPE__)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('activate) (logclear! (-> self mask) (process-mask actor-pause)) (go __TYPE__-activate))))
  :enter
    (behavior ()
      (clear-collide-with-as (-> self root)))
  :exit
    (behavior ()
      (restore-collide-with-as (-> self root))
      (logclear! (-> self draw status) (draw-status hidden)))
  :trans periscope-debug-trans
  :code
    (behavior ()
      (logior! (-> self mask) (process-mask actor-pause))
      (set! (-> self raised?) #f)
      (set! (-> self y-offset) 0.0)
      (set! (-> self y-offset-grips) (+ -20480.0 (-> self height)))
      (set! (-> self tilt) 16384.0)
      (set! (-> self turn) (+ 18204.445 (-> self target-turn)))
      (periscope-update-joints)
      (ja-post)
      (suspend)
      (update-transforms! (-> self root))
      (logior! (-> self draw status) (draw-status hidden))
      (loop
        (suspend))))

(defstate __TYPE__-activate (__TYPE__)
  :exit
    (behavior ()
      (sound-stop (-> self rise-sound-id))
      (sound-play "eco-tower-stop" :position (the-as symbol (-> self base))))
  :trans periscope-debug-trans
  :code
    (behavior ()
      (local-vars (v1-13 symbol))
      (logclear! (-> self mask) (process-mask actor-pause))
      (set-time! (-> self state-time))
      (link-to-next-and-prev-actor (-> self link))
      (periscope-find-next)
      (periscope-find-reflection-angles)
      (when (< 61440.0 (-> self height))
        (set! (-> self y-offset) (+ -61440.0 (-> self height)))
        (set! (-> self turn) (+ 18204.445 (-> self target-turn))))
      (until (and v1-13 (= (-> self turn) (-> self target-turn)) (= (-> self tilt) (-> self target-tilt)))
        (sound-play "eco-tower-rise" :id (-> self rise-sound-id) :position (the-as symbol (-> self base)))
        (seek! (-> self y-offset) (-> self height) (* 16384.0 (seconds-per-frame)))
        (seek! (-> self turn) (-> self target-turn) (* 7281.778 (seconds-per-frame)))
        (seek! (-> self tilt) (-> self target-tilt) (* 7281.778 (seconds-per-frame)))
        (set! (-> self raised?) (< (+ -12288.0 (-> self height)) (-> self y-offset)))
        (periscope-update-joints)
        (suspend)
        (set! v1-13 (= (-> self y-offset) (-> self height))))
      (set! (-> self raised?) #t)
      (go __TYPE__-wait-for-power-input))
  :post periscope-post)

(defstate __TYPE__-wait-for-power-input (__TYPE__)
  :code
    (behavior ()
      (logclear! (-> self mask) (process-mask actor-pause))
      (set! (-> self raised?) #t)
      (let ((f30-0 (+ -20480.0 (-> self height))))
        (until (= (-> self y-offset-grips) f30-0)
          (seek! (-> self y-offset-grips) f30-0 (* 16384.0 (seconds-per-frame)))
          (periscope-update-joints)
          (suspend)))
      (update-transforms! (-> self root))
      (set! (-> self y-offset) (-> self height))
      (loop
        (if (periscope-has-power-input?) (go __TYPE__-wait-for-player))
        (suspend)))
  :post ja-post)

(defstate __TYPE__-wait-for-player (__TYPE__)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('touch)
         (when (and *target*
                    (not (and (logtest? (-> *target* control unknown-surface00 flags) (surface-flags jump))
                              (not (logtest? (-> *target* control status) (cshape-moving-flags onsurf))))))
           (when ((method-of-type touching-shapes-entry prims-touching?)
                  (the-as touching-shapes-entry (-> block param 0))
                  (the-as collide-shape-moving (-> self root))
                  (the-as uint 1))
             (let ((v0-0 (the-as object #t))) (set! (-> self player-touching-grips?) (the-as symbol v0-0)) v0-0))))
        (('change-mode)
         (level-hint-spawn (text-id sidekick-hint-periscope) "sksp0049" (the-as entity #f) *entity-pool* (game-task none))
         (go __TYPE__-player-control))))
  :exit
    (behavior ()
      (sound-stop (-> self grips-sound-id)))
  :code
    (behavior ()
      (hide-hud)
      (logclear! (-> self mask) (process-mask actor-pause))
      (set! (-> self raised?) #t)
      (set! (-> self grips-moving?) #t)
      (let ((f30-0 8192.0)
            (gp-0 (res-lump-value (-> self entity) 'text-id uint128)))
        (until (= (-> self y-offset-grips) f30-0)
          (if (nonzero? gp-0) (level-hint-spawn (text-id zero) (the-as string #f) (-> self entity) *entity-pool* (game-task none)))
          (sound-play "site-moves" :id (-> self grips-sound-id) :position (the-as symbol (-> self grips transform)))
          (seek! (-> self y-offset-grips) f30-0 (* 16384.0 (seconds-per-frame)))
          (periscope-update-joints)
          (suspend)))
      (set! (-> self grips-moving?) #f)
      (set! (-> self player-touching-grips?) #f)
      (let ((gp-1 (new 'stack-no-clear 'vector))
            (s5-0 (new 'stack-no-clear 'vector))
            (s4-0 (new 'stack-no-clear 'vector))
            (s3-0 (new 'stack-no-clear 'vector)))
        (loop
          (set! (-> s5-0 quad) (-> self node-list data 4 bone transform vector 3 quad))
          (let ((a0-10 s5-0)
                (f30-1 81920.0))
            (when (and *target* (>= f30-1 (vector-vector-distance a0-10 (-> *target* control trans))))
              (when (logtest? (-> *target* control status) (cshape-moving-flags onsurf))
                (let ((f0-7 (fmax 4096.0 (fmin 12288.0 (+ (- 5120.0 (-> self base y)) (-> *target* control trans y))))))
                  (seek! (-> self y-offset-grips) f0-7 (* 16384.0 (seconds-per-frame)))))
              (vector-! gp-1 (target-pos 0) (-> self base))
              (vector-z-quaternion! s4-0 (-> self grips transform quat))
              (quaternion-rotate-y-to-vector! (-> self grips transform quat)
                                              (-> self grips transform quat)
                                              (the-as quaternion gp-1)
                                              (* 27306.666 (seconds-per-frame)))
              (vector-z-quaternion! s3-0 (-> self grips transform quat))
              (set! (-> self grips-moving?) (< (vector-dot s4-0 s3-0) (cos 182.04445)))
              (periscope-update-joints)
              (update-transforms! (-> self root))
              (when (and (-> self player-touching-grips?) (not (level-hint-displayed?)))
                (set! (-> self player-touching-grips?) #f)
                (hide-hud)
                (level-hint-surpress!)
                (kill-current-level-hint '() '(sidekick voicebox) 'exit)
                (when (and (hud-hidden?) (can-grab-display? self))
                  (let ((s2-2 (new 'stack 'font-context *font-default-matrix* 32 160 0.0 (font-color default) (font-flags shadow kerning))))
                    (let ((v1-43 s2-2)) (set! (-> v1-43 width) (the float 440)))
                    (let ((v1-44 s2-2)) (set! (-> v1-44 height) (the float 80)))
                    (set! (-> s2-2 flags) (font-flags shadow kerning large))
                    (print-game-text (lookup-text! *common-text* (text-id press-to-use) #f) s2-2 #f 128 22))
                  (when (cpad-pressed? 0 circle)
                    (set! (-> self grips-moving?) #f)
                    (loop
                      (send-event *target* 'change-mode 'periscope self)
                      (hide-hud)
                      (suspend)
                      (hide-hud)
                      (suspend)))))))
          (if (not (periscope-has-power-input?)) (go __TYPE__-wait-for-power-input))
          (suspend))))
  :post
    (behavior ()
      (if (-> self grips-moving?)
        (sound-play "site-moves" :id (-> self grips-sound-id) :position (the-as symbol (-> self grips transform)))
        (sound-stop (-> self grips-sound-id)))
      (periscope-draw-beam-impact)
      (ja-post)))

(defstate __TYPE__-player-control (__TYPE__)
