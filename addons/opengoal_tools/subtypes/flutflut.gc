;; Flut Flut for custom levels. Its eye textures (iris + lid) use a shared
;; texture page (983) that only a vanilla Swamp / Snow level's texture remap
;; translates, so with any other texture source the eyes are blank. This child
;; points those eye shaders at the Swamp copies (swamp-vis-pris 659: flut-eye-16x16
;; 40, flut-eyelid 92; the game loads that page on demand) before the vanilla init.
(deftype __TYPE__ (flutflut) ())

(defun __TYPE__-fix-eyes ((name string))
  (let ((ag (art-group-get-by-name *level* name)))
    (when ag
      (dotimes (i (-> ag length))
        (let ((e (-> ag data i)))
          (when (and e (type-type? (-> e type) merc-ctrl))
            (let ((ec (-> (the-as merc-ctrl e) header eye-ctrl)))
              (when (nonzero? ec)
                (dotimes (s 3)
                  (let ((sh (-> ec shader s)))
                    (when (= (-> sh texture-id page) 983)
                      (set! (-> sh texture-id)
                            (if (= s 2)
                              (new 'static 'texture-id :page 659 :index 92)
                              (new 'static 'texture-id :page 659 :index 40)))
                      (logior! (-> sh link-test) (link-test-flags needs-log-in))
                      (adgif-shader-login-no-remap sh)))))))))))
  (none))

;; The eyes are drawn from GS texture addresses bound when a page is uploaded in
;; the level's pris bucket. Page 659 isn't one of this level's pages, so a child
;; process re-binds it in that bucket every frame (PC: just the address binding).
(defun __TYPE__-upload-eye-page ((bucket bucket-id))
  (let ((pg (-> *texture-page-dir* entries 659 page)))
    (if (and pg (nonzero? pg))
      (upload-vram-pages *texture-pool* (-> *texture-pool* segment-common) pg -1 bucket)))
  (none))

(defmethod init-from-entity! ((this __TYPE__) (arg0 entity-actor))
  (__TYPE__-fix-eyes "flut-saddle")
  (__TYPE__-fix-eyes "eichar-flut+0")
  (process-spawn-function process
                          (lambda :behavior process ((b bucket-id))
                            (loop
                              (__TYPE__-upload-eye-page b)
                              (suspend)))
                          (if (zero? (-> arg0 extra level index)) (bucket-id pris-tex0) (bucket-id pris-tex1))
                          :to this)
  (call-parent-method this arg0)
  (none))
