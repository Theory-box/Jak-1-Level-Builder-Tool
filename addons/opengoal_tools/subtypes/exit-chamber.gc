;; Exit chamber: optional timed world-space path, otherwise animated travel.
;; External trigger/open unlocks; only the child button starts the ride.
;; Optional starts-closed and ride-camera; charger notifications can unlock it.
;; Its button and iris door are spawned and moved by the chamber. The original
;; rise/dive animations are relative to the placed transform (keep ample space).
;; Removed Sunken/Village level loads and the fixed camera sequence/cell position.
;; Optional task cell; saved ride-end state belongs to this entity (user-int8 1).
;; The button is a managed child, not a separately placed actor.
;; edits: exit-chamber

(deftype __TYPE__ (exit-chamber)
  ((route path-control)
   (path-time float)
   (path-progress float)
   (path-end symbol))
  (:states __TYPE__-locked __TYPE__-path-idle __TYPE__-path-ride
           __TYPE__-exit-chamber-idle-in-sunken
           (__TYPE__-exit-chamber-idle-in-village symbol)
           __TYPE__-exit-chamber-rise __TYPE__-exit-chamber-lower))


(defmethod relocate ((this __TYPE__) (offset int))
  (if (-> this route) (&+! (-> this route) offset))
  (call-parent-method this offset))

(defun __TYPE__-camera ((this __TYPE__) (enabled symbol))
  (let ((cam (res-lump-struct (-> this entity) 'ride-camera string)))
    (when cam (camera-change-to (if enabled cam (the-as string 'base)) 0 #f)))
  (none))

(defun __TYPE__-path-point ((p path-control) (u float) (pos vector))
  (cond
    ((type-type? (-> p type) curve-control) (eval-path-curve! p pos u 'interp))
    (else
      (let ((left (* u (path-distance p))) (done #f) (n (-> p curve num-cverts)))
        (dotimes (i (+ n -1))
          (when (not done)
            (let* ((a (-> p cverts i)) (b (-> p cverts (+ i 1))) (len (vector-vector-distance a b)))
              (when (or (<= left len) (= i (+ n -2)))
                (vector-lerp! pos a b (if (> len 0.0) (fmax 0.0 (fmin 1.0 (/ left len))) 0.0))
                (set! done #t))
              (-! left len)))))))
  (set! (-> pos w) 1.0)
  (none))

(defstate __TYPE__-locked (__TYPE__)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('trigger 'open)
        (if (-> self route) (go __TYPE__-path-idle) (go __TYPE__-exit-chamber-idle-in-sunken)))
      (('notify)
        (let ((index (the int (-> block param 1))))
          (when (and (>= index 1) (<= index 5))
            (case (-> block param 0)
              ((1) (logior! (-> self chargers-active) (ash 1 index)))
              ((2) (logclear! (-> self chargers-active) (ash 1 index))))
            (when (= (-> self chargers-active) 62)
              (if (-> self route) (go __TYPE__-path-idle) (go __TYPE__-exit-chamber-idle-in-sunken))))))))
  :code (behavior () (loop (suspend)))
  :post ja-post)

(defstate __TYPE__-path-idle (__TYPE__)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('trigger) (when (= proc (ppointer->process (-> self button))) (go __TYPE__-path-ride)))))
  :enter (behavior ()
    (set! (-> self move-player?) #f)
    (logior! (-> self entity extra perm status) (entity-perm-status user-set-from-cstage))
    (set! (-> self entity extra perm user-int8 1) (if (-> self path-end) 2 1))
    (when (-> self door) (send-event (ppointer->process (-> self door)) 'trigger))
    (when (-> self button) (send-event (ppointer->process (-> self button)) 'untrigger)))
  :trans rider-trans
  :code (behavior () (loop (suspend)))
  :post (behavior () (rider-post) (exit-chamber-method-23 self #t)))

(defstate __TYPE__-path-ride (__TYPE__)
  :enter (behavior ()
    (set! (-> self move-player?) #t)
    (set! (-> self path-progress) 0.0)
    (__TYPE__-camera self #t)
    (when (-> self door) (send-event (ppointer->process (-> self door)) 'untrigger)))
  :exit (behavior ()
    (set! (-> self move-player?) #f)
    (__TYPE__-camera self #f))
  :code (behavior ()
    (set-time! (-> self state-time))
    (until (time-elapsed? (-> self state-time) (seconds 1)) (suspend))
    (until (>= (-> self path-progress) 1.0)
      (+! (-> self path-progress) (/ (seconds-per-frame) (-> self path-time)))
      (let ((u (fmin 1.0 (-> self path-progress))))
        (__TYPE__-path-point (-> self route) (if (-> self path-end) (- 1.0 u) u) (-> self root trans)))
      (suspend))
    (set! (-> self path-end) (not (-> self path-end)))
    (go __TYPE__-path-idle))
  :post (behavior () (transform-post) (exit-chamber-method-23 self #t)))

(defstate __TYPE__-exit-chamber-idle-in-sunken (__TYPE__)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (local-vars (v0-1 object))
      (case message
        (('trigger) (when (= proc (ppointer->process (-> self button))) (go __TYPE__-exit-chamber-rise)))
        (('notify)
         (when (and (= (-> proc type) fuel-cell) (= (-> block param 0) 'pickup))
           (let ((a0-5 (handle->process (-> self fcell-handle))))
             (when a0-5
               (let ((v1-10 (new 'stack-no-clear 'vector)))
                 (set-vector! v1-10 0.0 64102.4 0.0 1.0)
                 (vector+! v1-10 v1-10 (-> self last-pos))
                 (send-event a0-5 'set-movie-pos v1-10))))))))
  :exit
    (behavior ()
      (logclear! (-> self draw status) (draw-status hidden)))
  :code
    (behavior ()
      (logior! (-> self entity extra perm status) (entity-perm-status user-set-from-cstage))
      (set! (-> self entity extra perm user-int8 1) 1)
      (set! (-> self wave-scale) 0.0)
      (if (-> self door) (send-event (ppointer->process (-> self door)) 'trigger))
      (if (-> self button) (send-event (ppointer->process (-> self button)) 'untrigger))
      (loop
        (if (>= 214228270000.0 (vector-vector-distance-squared (camera-pos) (-> self root trans)))
          (logclear! (-> self draw status) (draw-status hidden))
          (logior! (-> self draw status) (draw-status hidden)))
        (suspend))))

(defstate __TYPE__-exit-chamber-idle-in-village (__TYPE__)
  :event
    (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
      (case message
        (('trigger) (when (= proc (ppointer->process (-> self button))) (go __TYPE__-exit-chamber-lower)))
        (('notify)
         (when (and (= (-> proc type) fuel-cell) (= (-> block param 0) 'pickup))
           (let ((a0-5 (handle->process (-> self fcell-handle))))
             (when a0-5
               (let ((v1-8 (new 'stack-no-clear 'vector)))
                 (set-vector! v1-8 0.0 64102.4 0.0 1.0)
                 (vector+! v1-8 v1-8 (-> self last-pos))
                 (send-event a0-5 'set-movie-pos v1-8))))))))
  :enter
    (behavior ((arg0 symbol))
      (logior! (-> self mask) (process-mask platform))
      (set-time! (-> self state-time)))
  :exit
    (behavior ()
      (logclear! (-> self mask) (process-mask platform)))
  :trans
    (behavior ()
      (rider-trans)
      (when *target*
        (let ((f30-0 (vector-vector-xz-distance (target-pos 0) (-> self last-pos))))
          (when (-> self door)
            (if (and *target* (>= 114688.0 f30-0))
              (send-event (ppointer->process (-> self door)) 'trigger)
              (send-event (ppointer->process (-> self door)) 'untrigger)))
          (when (and (-> self play-assistant-message?) (>= f30-0 57344.0))
            (set! (-> self play-assistant-message?) #f)
            (level-hint-spawn (text-id sunken-room-resolution) "asstvb22" (the-as entity #f) *entity-pool* (game-task none))))))
  :code
    (behavior ((arg0 symbol))
      (set! (-> self move-player?) #f)
      (set! (-> self wave-scale) 1.0)
      (logior! (-> self entity extra perm status) (entity-perm-status user-set-from-cstage))
      (set! (-> self entity extra perm user-int8 1) 2)
      (if (-> self button) (send-event (ppointer->process (-> self button)) 'untrigger))
      (when arg0
        (logior! (-> self draw status) (draw-status skip-bones))
        (exit-chamber-method-20 self 1.0)
        (suspend)
        (logclear! (-> self draw status) (draw-status skip-bones)))
      (loop
        (exit-chamber-method-20 self 1.0)
        (suspend)))
  :post
    (behavior ()
      (rider-post)
      (exit-chamber-method-23 self #t)
      (if (and *target* (>= (vector-vector-xz-distance (target-pos 0) (-> self last-pos)) 40960.0))
        (spawn (-> self part) (-> self last-pos)))))

(defstate __TYPE__-exit-chamber-rise (__TYPE__)
  :enter
    (behavior ()
      (__TYPE__-camera self #t)
      (set! (-> self move-player?) #f))
  :exit (behavior () (__TYPE__-camera self #f))
  :trans
    (behavior ()
      (if (not (-> self move-player?)) (rider-trans)))
  :code
    (behavior ()
      (let ((v1-1 (handle->process (-> self fcell-handle))))
        (if v1-1 (clear-collide-with-as (-> (the-as fuel-cell v1-1) root))))
      (when (!= (-> self entity extra perm task) (game-task none)) (close-specific-task! (-> self entity extra perm task) (task-status need-reminder)))
      (send-event *target* 'reset-pickup 'eco)
      (set-time! (-> self state-time))
      (let ((gp-1 #f))
        (ja-no-eval :group! exit-chamber-start-door-shut-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (when (and (not gp-1) (time-elapsed? (-> self state-time) (seconds 0.75)) (-> self door))
            (set! gp-1 #t)
            (send-event (ppointer->process (-> self door)) 'untrigger))
          (suspend)
          (ja :num! (seek!))))
      (set! (-> self move-player?) #t)
      (ja-no-eval :group! exit-chamber-start-in-room-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!)))

      (ja-no-eval :group! exit-chamber-middle-in-water-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (exit-chamber-method-24 self 51200.0)
        (update-trans! (-> self sound) (-> self last-pos))
        (update! (-> self sound))
        (suspend)
        (ja :num! (seek!)))
      (stop! (-> self sound))


      (let ((gp-2 #f))
        (ja-no-eval :group! exit-chamber-end-out-of-water-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (seek! (-> self wave-scale) 1.0 0.0016666667)
          (exit-chamber-method-20 self (-> self wave-scale))
          (if (and (-> self move-player?) (>= (ja-aframe-num 0) 310.0)) (set! (-> self move-player?) #f))
          (let ((a0-36 (new 'stack-no-clear 'vector)))
            (set! (-> a0-36 quad) (-> self last-pos quad))
            (+! (-> a0-36 y) 51814.4)
            (when (>= (-> a0-36 y) (ocean-get-height a0-36))
              (if (not gp-2) (set! gp-2 #t))
              (spawn (-> self part) (-> self last-pos))
              (spawn (-> self part) (-> self last-pos))
              (spawn (-> self part) (-> self last-pos))))
          (suspend)
          (ja :num! (seek!))))
      (kill-and-free-particles (-> self part))

      (send-event *target* 'dry)
      (let ((v1-143 (handle->process (-> self fcell-handle))))
        (if v1-143 (restore-collide-with-as (-> (the-as fuel-cell v1-143) root))))
      (set-time! (-> self state-time))
      (until (time-elapsed? (-> self state-time) (seconds 0.5))
        (seek! (-> self wave-scale) 1.0 0.0016666667)
        (exit-chamber-method-20 self (-> self wave-scale))
        (suspend))
      (if (-> self door) (send-event (ppointer->process (-> self door)) 'trigger))
      (set-time! (-> self state-time))
      (until (time-elapsed? (-> self state-time) (seconds 2.5))
        (seek! (-> self wave-scale) 1.0 0.0016666667)
        (exit-chamber-method-20 self (-> self wave-scale))
        (suspend))
      (go __TYPE__-exit-chamber-idle-in-village #f))
  :post
    (behavior ()
      (if (-> self move-player?) (transform-post) (rider-post))
      (exit-chamber-method-23 self #t)))

(defstate __TYPE__-exit-chamber-lower (__TYPE__)
  :enter
    (behavior ()
      (__TYPE__-camera self #t)
      (set! (-> self move-player?) #t)
      (let ((v1-2 (handle->process (-> self fcell-handle))))
        (if v1-2 (clear-collide-with-as (-> (the-as fuel-cell v1-2) root)))))
  :exit (behavior () (__TYPE__-camera self #f))
  :trans
    (behavior ()
      (if (not (-> self move-player?)) (rider-trans))
      (seek! (-> self wave-scale) 0.0 0.0016666667)
      (exit-chamber-method-20 self (-> self wave-scale)))
  :code
    (behavior ()
      (set-time! (-> self state-time))
      (let ((gp-1 #f)
            (s5-0 #f))
        (ja-no-eval :group! exit-chamber-dive-start-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (when (and (not gp-1) (time-elapsed? (-> self state-time) (seconds 0.25)) (-> self door))
            (set! gp-1 #t)
            (send-event (ppointer->process (-> self door)) 'untrigger))
          (when (+ (current-time) (seconds -0.1))
            (let ((a0-9 (new 'stack-no-clear 'vector)))
              (set! (-> a0-9 quad) (-> self last-pos quad))
              (+! (-> a0-9 y) 64102.4)
              (when (< (-> a0-9 y) (+ 12288.0 (ocean-get-height a0-9)))
                (if (not s5-0) (set! s5-0 #t))))
            (spawn (-> self part) (-> self last-pos)))
          (suspend)
          (ja :num! (seek!))))

      (kill-and-free-particles (-> self part))
      (ja-no-eval :group! exit-chamber-dive-middle-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (exit-chamber-method-24 self 47104.0)
        (update-trans! (-> self sound) (-> self last-pos))
        (update! (-> self sound))
        (suspend)
        (ja :num! (seek!)))
      (stop! (-> self sound))


      (ja-no-eval :group! exit-chamber-dive-end-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!)))
      (set! (-> self move-player?) #f)
      (if (-> self door) (send-event (ppointer->process (-> self door)) 'trigger))
      (let ((v1-109 (handle->process (-> self fcell-handle))))
        (if v1-109 (restore-collide-with-as (-> (the-as fuel-cell v1-109) root))))
      (set-time! (-> self state-time))
      (until (time-elapsed? (-> self state-time) (seconds 3))
        (suspend))
      (go __TYPE__-exit-chamber-idle-in-sunken))
  :post
    (behavior ()
